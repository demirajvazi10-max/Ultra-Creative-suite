<Window x:Class="UltraComposer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultra Composer" Height="800" Width="860"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" x:Name="MainMenu">
            <MenuItem x:Name="FileMenuItem" Header="_Fajl">
                <MenuItem x:Name="OpenProjectMenuItem" Header="_Otvori projekat..." Click="OpenProjectMenuItem_Click" />
                <MenuItem x:Name="SaveProjectMenuItem" Header="_Sačuvaj projekat" Click="SaveProjectMenuItem_Click" />
                <MenuItem x:Name="SaveProjectAsMenuItem" Header="Sačuvaj _kao..." Click="SaveProjectAsMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="_Izlaz" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="ViewMenuItem" Header="_Prikaz">
                <MenuItem x:Name="ShowInstrumentsMenuItem" Header="_Banka instrumenata" IsCheckable="True" IsChecked="True"
                          Click="ShowInstrumentsMenuItem_Click" />
                <MenuItem x:Name="ShowSequencerMenuItem" Header="_Sekvenser" IsCheckable="True"
                          Click="ShowSequencerMenuItem_Click" />
                <MenuItem x:Name="ShowArrangerMenuItem" Header="_Aranžer" IsCheckable="True"
                          Click="ShowArrangerMenuItem_Click" />
                <MenuItem x:Name="ShowMultiTrackMenuItem" Header="_Multi-trake i mikser" IsCheckable="True"
                          Click="ShowMultiTrackMenuItem_Click" />
                <MenuItem x:Name="ShowAccompanimentMenuItem" Header="_Auto-pratnja" IsCheckable="True"
                          Click="ShowAccompanimentMenuItem_Click" />
                <MenuItem x:Name="ShowSoundMenuItem" Header="_Zvuk i efekti" IsCheckable="True"
                          Click="ShowSoundMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="LanguageMenuItem" Header="_Jezik">
                <MenuItem x:Name="LanguageSerbianMenuItem" Header="Srpski" IsCheckable="True"
                          Click="LanguageSerbianMenuItem_Click" />
                <MenuItem x:Name="LanguageEnglishMenuItem" Header="Engleski" IsCheckable="True" IsChecked="True"
                          Click="LanguageEnglishMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="_Pomoć">
                <MenuItem x:Name="UserGuideMenuItem" Header="_Uputstvo za upotrebu" Click="UserGuideMenuItem_Click" />
                <MenuItem x:Name="SupportMenuItem" Header="Kako podržati p_rojekat" Click="SupportMenuItem_Click" />
                <MenuItem x:Name="AboutMenuItem" Header="_O programu" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ultra Composer" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

            <TextBlock x:Name="StatusText" Grid.Row="1"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Motor za zvuk nije pokrenut."
                       Margin="0,0,0,12" />

            <!-- ==================== Banka instrumenata (MIDI + VST3 + SoundFont + auto-terca + klavijatura) ==================== -->
            <StackPanel Grid.Row="2" x:Name="InstrumentsView">
                <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MidiLabelText" Text="MIDI uređaj:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="MidiPortComboBox" Width="220" VerticalAlignment="Center" />
                        <Button x:Name="RefreshMidiButton" Content="Osveži uređaje" Margin="8,0,0,0"
                                Click="RefreshMidiButton_Click" />
                        <Button x:Name="ConnectMidiButton" Content="Poveži" Margin="8,0,0,0"
                                Click="ConnectMidiButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="MidiStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,4,0,0"
                               Text="Nijedan MIDI uredjaj nije pronadjen." />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="VstIntroText" TextWrapping="Wrap"
                               Text="VST3 instrument (putanja do .vst3 fajla ili fascikle) - ukucaj/nalepi putanju, ili je pronađi dugmetom 'Pretraži':" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="VstPathTextBox" Width="320" />
                        <Button x:Name="BrowseVstButton" Content="Pretraži..." Margin="8,0,0,0"
                                Click="BrowseVstButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="LoadVstButton" Content="Učitaj instrument" Click="LoadVstButton_Click" />
                        <Button x:Name="UnloadVstButton" Content="Isključi instrument" Margin="8,0,0,0"
                                Click="UnloadVstButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="VstStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,4,0,0"
                               Text="Nijedan VST3 instrument nije učitan - svira samo ugrađeni sintisajzer." />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="SfIntroText" TextWrapping="Wrap"
                               Text="Zvučna banka (SoundFont, .sf2) - gotovi instrumenti kao u Cakewalk-u (klavir, žice, bubnjevi, gitara...). Podrazumevano je već upisana ugrađena banka koja radi odmah; ukucaj/nalepi drugu putanju, ili je pronađi dugmetom 'Pretraži', da učitaš neku svoju:" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="SoundFontPathTextBox" Width="320" />
                        <Button x:Name="BrowseSoundFontButton" Content="Pretraži..." Margin="8,0,0,0"
                                Click="BrowseSoundFontButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="LoadSoundFontButton" Content="Učitaj banku" Click="LoadSoundFontButton_Click" />
                        <Button x:Name="UnloadSoundFontButton" Content="Isključi banku" Margin="8,0,0,0"
                                Click="UnloadSoundFontButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="SfInstrumentLabelText" Text="Instrument:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="SoundFontPresetComboBox" Width="220" VerticalAlignment="Center"
                                  IsEnabled="False"
                                  SelectionChanged="SoundFontPresetComboBox_SelectionChanged" />
                    </StackPanel>
                    <TextBlock x:Name="SoundFontStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,4,0,0"
                               Text="Nijedna SoundFont banka nije učitana - svira samo ugrađeni sintisajzer." />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="AutoThirdSectionTitleText"
                               Text="Automatska terca (svaka odsvirana nota dobija automatski i drugi glas, tercu iznad ili ispod - radi svugde, i sa MIDI-jem i bez njega):"
                               FontWeight="Bold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="AutoThirdCheckBox" Content="Uključi automatsku tercu" VerticalAlignment="Center"
                                  Click="AutoThirdCheckBox_Click" />
                        <RadioButton x:Name="AutoThirdUpperRadio" Content="Gornja terca" GroupName="AutoThirdDirection"
                                     VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"
                                     Click="AutoThirdDirection_Click" />
                        <RadioButton x:Name="AutoThirdLowerRadio" Content="Donja terca" GroupName="AutoThirdDirection"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     Click="AutoThirdDirection_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="AutoThirdScaleLabelText" Text="Skala (radi tačnu tercu iz cele skale, ne samo veliku):" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="AutoThirdScaleRootComboBox" Width="70" VerticalAlignment="Center"
                                  SelectionChanged="AutoThirdScale_Changed" />
                        <RadioButton x:Name="AutoThirdScaleMajorRadio" Content="Dur" GroupName="AutoThirdScaleType"
                                     VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"
                                     Click="AutoThirdScale_Changed" />
                        <RadioButton x:Name="AutoThirdScaleMinorRadio" Content="Mol" GroupName="AutoThirdScaleType"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     Click="AutoThirdScale_Changed" />
                        <RadioButton x:Name="AutoThirdScaleHijazRadio" Content="Hidžaz" GroupName="AutoThirdScaleType"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     Click="AutoThirdScale_Changed" />
                        <RadioButton x:Name="AutoThirdScaleHijazKarRadio" Content="Hidžaz kar" GroupName="AutoThirdScaleType"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     Click="AutoThirdScale_Changed" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="PerfLayersTitleText" FontWeight="Bold" TextWrapping="Wrap"
                               Text="Slojevi instrumenata (Layer i Split, kao na pravim klavijaturama):" />
                    <TextBlock x:Name="PerfLayersExplainText" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Sloj 1 je glavni instrument (VST3/zvučna banka gore). 'Ceo opseg' znači da sloj svira preko cele tastature zajedno sa ostalim uključenim slojevima (Layer); 'Donji deo'/'Gornji deo' dele tastaturu na dve zone na granici podele ispod (Split) - kombinuj kako želiš, čak i sva tri odjednom." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="PerfLayerSelectLabelText" Text="Sloj:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="PerfLayerComboBox" Width="100" VerticalAlignment="Center"
                                  SelectionChanged="PerfLayerComboBox_SelectionChanged" />
                        <CheckBox x:Name="PerfLayerEnabledCheckBox" Content="Uključen" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Click="PerfLayerEnabledCheckBox_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="PerfLayerSynthRadio" Content="Ugrađeni sintisajzer" GroupName="PerfLayerInstrumentMode"
                                     VerticalAlignment="Center" IsChecked="True" Click="PerfLayerInstrumentMode_Click" />
                        <RadioButton x:Name="PerfLayerSoundFontRadio" Content="Zvučna banka (posebna za ovaj sloj)" GroupName="PerfLayerInstrumentMode"
                                     VerticalAlignment="Center" Margin="16,0,0,0" Click="PerfLayerInstrumentMode_Click" />
                        <RadioButton x:Name="PerfLayerVstRadio" Content="VST3 (poseban za ovaj sloj)" GroupName="PerfLayerInstrumentMode"
                                     VerticalAlignment="Center" Margin="16,0,0,0" Click="PerfLayerInstrumentMode_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PerfLayerSfPathLabelText" Text="Putanja do .sf2:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PerfLayerSoundFontPathTextBox" Width="260" />
                        <Button x:Name="PerfBrowseLayerSoundFontButton" Content="Pretraži..." Margin="8,0,0,0"
                                Click="PerfBrowseLayerSoundFontButton_Click" />
                        <Button x:Name="PerfLoadLayerSoundFontButton" Content="Učitaj banku za ovaj sloj" Margin="8,0,0,0"
                                Click="PerfLoadLayerSoundFontButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PerfLayerPresetLabelText" Text="Instrument u banci:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="PerfLayerSoundFontPresetComboBox" Width="220" VerticalAlignment="Center"
                                  IsEnabled="False" SelectionChanged="PerfLayerSoundFontPresetComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PerfLayerVstPathLabelText" Text="Putanja do .vst3:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PerfLayerVstPathTextBox" Width="260" />
                        <Button x:Name="PerfBrowseLayerVstButton" Content="Pretraži..." Margin="8,0,0,0"
                                Click="PerfBrowseLayerVstButton_Click" />
                        <Button x:Name="PerfLoadLayerVstButton" Content="Učitaj VST za ovaj sloj" Margin="8,0,0,0"
                                Click="PerfLoadLayerVstButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="PerfLayerVolumeLabelText" Text="Jačina (0-150%):" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PerfLayerVolumeTextBox" Width="45" Text="100" />
                        <TextBlock x:Name="PerfLayerOctaveLabelText" Text="Pomeraj oktave (-2..2):" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox x:Name="PerfLayerOctaveTextBox" Width="45" Text="0" />
                        <TextBlock x:Name="PerfLayerRangeLabelText" Text="Opseg:" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <ComboBox x:Name="PerfLayerRangeComboBox" Width="120" VerticalAlignment="Center" />
                        <Button x:Name="ApplyPerfLayerSettingsButton" Content="Primeni" Margin="8,0,0,0" Click="ApplyPerfLayerSettingsButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="PerfSplitLabelText" Text="Granica podele za slojeve (nota, npr. c4):" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PerfSplitPointTextBox" Width="70" Text="c4" />
                        <Button x:Name="ApplyPerfSplitPointButton" Content="Primeni" Margin="8,0,0,0" Click="ApplyPerfSplitPointButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PerfLayerStatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Sloj 1: uključen, ceo opseg, jačina 100%." />
                </StackPanel>

                <Border x:Name="PerformanceKeyboardBorder"
                        Focusable="True"
                        BorderBrush="Gray" BorderThickness="1" Padding="12"
                        PreviewKeyDown="PerformanceKeyboard_PreviewKeyDown"
                        PreviewKeyUp="PerformanceKeyboard_PreviewKeyUp"
                        GotKeyboardFocus="PerformanceKeyboard_GotFocus"
                        LostKeyboardFocus="PerformanceKeyboard_LostFocus">
                    <StackPanel>
                        <TextBlock x:Name="KeyboardIntroText" TextWrapping="Wrap"
                                   Text="Fokusiraj ovo polje (Tab) da bi tasteri Z-M i Q-U svirali note. Page Up / Page Down menjaju oktavu. Strelica gore/dole menja instrument iz učitane SoundFont banke." />
                        <TextBlock x:Name="OctaveText"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,8,0,0" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Sekvenser ==================== -->
            <StackPanel Grid.Row="2" x:Name="SequencerView" Visibility="Collapsed">
                <TextBlock x:Name="SeqTitleText" Text="Sekvenser (spisak nota koje se automatski sviraju u petlji):" FontWeight="Bold" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="SeqNoteLabelText" Text="Nota ili akord (npr. c4, ili c4, e4, g4):" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="NotePitchTextBox" Width="110" Text="c4" />
                    <TextBlock x:Name="SeqStartLabelText" Text="Početak (otkucaji):" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="NoteStartTextBox" Width="45" Text="0" />
                    <TextBlock x:Name="SeqLengthLabelText" Text="Trajanje (otkucaji):" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="NoteLengthTextBox" Width="45" Text="1" />
                    <TextBlock x:Name="SeqVelocityLabelText" Text="Jačina (1-127):" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="NoteVelocityTextBox" Width="45" Text="100" />
                    <Button x:Name="AddNoteButton" Content="Dodaj notu/akord" Margin="8,0,0,0" Click="AddNoteButton_Click" />
                    <Button x:Name="ListenForChordButton" Content="Slušaj akord" Margin="8,0,0,0" Click="ListenForChordButton_Click" />
                    <Button x:Name="StopListenForChordButton" Content="Prestani da slušaš" Margin="8,0,0,0"
                            Click="StopListenForChordButton_Click" IsEnabled="False" />
                </StackPanel>

                <ListView x:Name="NotesListView" Height="110" Margin="0,4,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="SeqColNote" Header="Nota" DisplayMemberBinding="{Binding PitchDisplay}" Width="110" />
                            <GridViewColumn x:Name="SeqColStart" Header="Početak (otkucaji)" DisplayMemberBinding="{Binding StartBeat}" Width="120" />
                            <GridViewColumn x:Name="SeqColLength" Header="Trajanje (otkucaji)" DisplayMemberBinding="{Binding LengthBeats}" Width="120" />
                            <GridViewColumn x:Name="SeqColVelocity" Header="Jačina" DisplayMemberBinding="{Binding Velocity}" Width="60" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="RemoveNoteButton" Content="Ukloni izabranu notu" Click="RemoveNoteButton_Click" />
                    <Button x:Name="ClearNotesButton" Content="Obriši sve note" Margin="8,0,0,0" Click="ClearNotesButton_Click" />
                    <TextBlock x:Name="SeqTempoLabelText" Text="Tempo (BPM):" VerticalAlignment="Center" Margin="16,0,4,0" />
                    <TextBox x:Name="TempoTextBox" Width="45" Text="120" />
                    <TextBlock x:Name="SeqLoopLabelText" Text="Dužina petlje (otkucaji):" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox x:Name="LoopLengthTextBox" Width="45" Text="16" />
                    <Button x:Name="PlaySequencerButton" Content="Sviraj" Margin="16,0,0,0" Click="PlaySequencerButton_Click" />
                    <Button x:Name="StopSequencerButton" Content="Zaustavi" Margin="8,0,0,0"
                            Click="StopSequencerButton_Click" IsEnabled="False" />
                </StackPanel>

                <TextBlock x:Name="SequencerStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,4,0,0"
                           Text="Sekvenser je prazan - dodaj bar jednu notu." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="PianoRollToggleCheckBox" Content="Prikaži piano roll (vizuelni prikaz, dodatak spisku)"
                              Click="PianoRollToggleCheckBox_Click" />
                </StackPanel>
                <StackPanel x:Name="PianoRollPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock x:Name="PianoRollInstructionsText" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ScrollViewer Height="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  BorderBrush="Gray" BorderThickness="1">
                        <Canvas x:Name="PianoRollCanvas" Background="White" Width="1920" Height="840"
                                MouseLeftButtonDown="PianoRollCanvas_MouseLeftButtonDown"
                                MouseRightButtonDown="PianoRollCanvas_MouseRightButtonDown" />
                    </ScrollViewer>
                </StackPanel>

                <TextBlock x:Name="SeqTipText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="Savet: kad sekvenser ima notu ili akord kakav želiš, pređi na Aranžer (meni Prikaz) i sačuvaj ovaj spisak kao obrazac." />
            </StackPanel>

            <!-- ==================== Aranžer ==================== -->
            <StackPanel Grid.Row="2" x:Name="ArrangerView" Visibility="Collapsed">
                <TextBlock x:Name="ArrTitleText"
                           Text="Aranžer (poređaj sačuvane obrasce jedan za drugim, npr. kitica, kitica, refren, kitica):"
                           FontWeight="Bold" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="ArrNameLabelText" Text="Ime obrasca:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="ArrangerPatternNameTextBox" Width="160" />
                    <Button x:Name="SavePatternButton" Content="Sačuvaj trenutni sekvenser kao obrazac" Margin="8,0,0,0"
                            Click="SavePatternButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ArrSaveExplainText" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Ovo uzima spisak nota i dužinu petlje koji trenutno stoje u Sekvenseru (meni Prikaz) i čuva ih ovde pod izabranim imenom, kao poseban obrazac. Sekvenser posle toga ostaje nezavisan - promene u njemu ne menjaju već sačuvani obrazac." />

                <TextBlock x:Name="ArrPatternsLabelText" Text="Sačuvani obrasci:" FontWeight="Bold" Margin="0,12,0,0" />
                <ListBox x:Name="ArrangerPatternsListBox" Height="90" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="AppendPatternToOrderButton" Content="Dodaj u redosled" Click="AppendPatternToOrderButton_Click" />
                    <Button x:Name="RemovePatternButton" Content="Ukloni izabrani obrazac" Margin="8,0,0,0"
                            Click="RemovePatternButton_Click" />
                </StackPanel>

                <TextBlock x:Name="ArrOrderLabelText" Text="Redosled sviranja:" FontWeight="Bold" Margin="0,12,0,0" />
                <ListBox x:Name="ArrangerOrderListBox" Height="90" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="RemoveLastFromOrderButton" Content="Ukloni poslednji iz redosleda" Click="RemoveLastFromOrderButton_Click" />
                    <Button x:Name="ClearOrderButton" Content="Obriši ceo redosled" Margin="8,0,0,0" Click="ClearOrderButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="ArrTempoLabelText" Text="Tempo (BPM):" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="ArrangerTempoTextBox" Width="45" Text="120" />
                    <Button x:Name="PlayArrangerButton" Content="Sviraj aranžman" Margin="16,0,0,0" Click="PlayArrangerButton_Click" />
                    <Button x:Name="StopArrangerButton" Content="Zaustavi" Margin="8,0,0,0"
                            Click="StopArrangerButton_Click" IsEnabled="False" />
                </StackPanel>

                <TextBlock x:Name="ArrangerStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,8,0,0"
                           Text="Aranžer je prazan - sačuvaj bar jedan obrazac i dodaj ga u redosled." />
            </StackPanel>

            <!-- ==================== Multi-trake i mikser ==================== -->
            <StackPanel Grid.Row="2" x:Name="MultiTrackView" Visibility="Collapsed">
                <TextBlock x:Name="MixTitleText" FontWeight="Bold" TextWrapping="Wrap"
                           Text="Multi-trake i mikser (više traka odjednom, svaka sa svojim instrumentom, jačinom i pan-om):" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="MixNewTrackNameLabelText" Text="Ime nove trake:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="NewTrackNameTextBox" Width="160" />
                    <Button x:Name="AddTrackButton" Content="Dodaj traku" Margin="8,0,0,0" Click="AddTrackButton_Click" />
                </StackPanel>

                <TextBlock x:Name="MixTracksLabelText" Text="Trake:" FontWeight="Bold" Margin="0,12,0,0" />
                <ListBox x:Name="MixTracksListBox" Height="90" Margin="0,4,0,0"
                         SelectionChanged="MixTracksListBox_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="RemoveTrackButton" Content="Ukloni izabranu traku" Click="RemoveTrackButton_Click" />
                </StackPanel>

                <StackPanel x:Name="MixTrackDetailPanel" IsEnabled="False" Margin="0,12,0,0">
                    <TextBlock x:Name="MixSelectedTrackTitleText" Text="Izabrana traka:" FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="MixRenameLabelText" Text="Ime:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="TrackNameTextBox" Width="160" />
                        <Button x:Name="RenameTrackButton" Content="Preimenuj" Margin="8,0,0,0" Click="RenameTrackButton_Click" />
                    </StackPanel>


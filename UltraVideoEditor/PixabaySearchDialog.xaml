<Window x:Class="UltraVideoEditor.PixabaySearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltraVideoEditor"
        Title="🔍 Pixabay Search" Height="850" Width="950"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBg}"
        AutomationProperties.Name="Pixabay image and video search">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔍 PIXABAY SEARCH" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- API Key -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Pixabay API key:" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtApiKey" Width="350" Height="30" 
                             Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"
                             AutomationProperties.Name="Pixabay API key"/>
                <TextBlock Text="Dobijte ga besplatno na pixabay.com/api/docs/" 
                           Foreground="#888" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Pretraga i filteri -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <!-- Red 1: Pojam i dugme -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🔎 Search term:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSearch" Width="300" Height="30" 
                             Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"
                             AutomationProperties.Name="Search term"
                             KeyDown="txtSearch_KeyDown"/>
                    <Button x:Name="btnSearch" Content="🔍 SEARCH" Click="btnSearch_Click"
                            Width="100" Height="30" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Red 2: Tip medija i orijentacija -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🎬 Media type:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbMediaType" Width="120" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0"
                              SelectionChanged="cmbMediaType_SelectionChanged" AutomationProperties.Name="Media type">
                        <ComboBoxItem Content="📸 Photos" Tag="photo" IsSelected="True"/>
                        <ComboBoxItem Content="🎥 Videos" Tag="video"/>
                    </ComboBox>

                    <TextBlock Text="🔄 Orientation:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbOrientation" Width="100" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Orientation">
                        <ComboBoxItem Content="All" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="📱 Horizontal" Tag="horizontal"/>
                        <ComboBoxItem Content="📱 Vertical" Tag="vertical"/>
                    </ComboBox>
                </StackPanel>

                <!-- Red 3: Kategorija i boja -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📁 Category:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbCategory" Width="130" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0" AutomationProperties.Name="Category">
                        <ComboBoxItem Content="All" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="🌿 Nature" Tag="nature"/>
                        <ComboBoxItem Content="👨‍👩‍👧‍👦 People" Tag="people"/>
                        <ComboBoxItem Content="🐶 Animals" Tag="animals"/>
                        <ComboBoxItem Content="⚽ Sport" Tag="sports"/>
                        <ComboBoxItem Content="✈️ Travel" Tag="travel"/>
                        <ComboBoxItem Content="🏢 Buildings" Tag="buildings"/>
                        <ComboBoxItem Content="🍕 Food" Tag="food"/>
                        <ComboBoxItem Content="🎵 Music" Tag="music"/>
                    </ComboBox>

                    <TextBlock Text="🎨 Color (images only):" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbColor" Width="100" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Color, images only">
                        <ComboBoxItem Content="All" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="🔴 Red" Tag="red"/>
                        <ComboBoxItem Content="🔵 Blue" Tag="blue"/>
                        <ComboBoxItem Content="🟢 Green" Tag="green"/>
                        <ComboBoxItem Content="🟡 Yellow" Tag="yellow"/>
                        <ComboBoxItem Content="🟠 Orange" Tag="orange"/>
                        <ComboBoxItem Content="🩷 Pink" Tag="pink"/>
                        <ComboBoxItem Content="⚫ Black" Tag="black"/>
                        <ComboBoxItem Content="⚪ White" Tag="white"/>
                    </ComboBox>
                </StackPanel>

                <!-- Row 4: Min width and Editors Choice -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📏 Min. width:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbMinWidth" Width="100" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0" AutomationProperties.Name="Minimum width">
                        <ComboBoxItem Content="Any" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="640px" Tag="640"/>
                        <ComboBoxItem Content="800px" Tag="800"/>
                        <ComboBoxItem Content="1024px" Tag="1024"/>
                        <ComboBoxItem Content="1280px" Tag="1280"/>
                        <ComboBoxItem Content="1920px" Tag="1920"/>
                    </ComboBox>

                    <TextBlock Text="⭐ Editors Choice:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkEditorsChoice" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <!-- Red 5: Video filteri (prikazuju se samo kad je video tip) -->
                <StackPanel x:Name="videoFilters" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="⏱ Min. duration (s):" Foreground="{DynamicResource TextPrimary}" Width="120" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbMinDuration" Width="80" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0" AutomationProperties.Name="Minimum duration in seconds">
                        <ComboBoxItem Content="Any" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="3s" Tag="3"/>
                        <ComboBoxItem Content="5s" Tag="5"/>
                        <ComboBoxItem Content="10s" Tag="10"/>
                        <ComboBoxItem Content="15s" Tag="15"/>
                        <ComboBoxItem Content="20s" Tag="20"/>
                    </ComboBox>

                    <TextBlock Text="📹 Video resolution:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbVideoQuality" Width="100" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Video resolution">
                        <ComboBoxItem Content="All" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="HD" Tag="hd"/>
                        <ComboBoxItem Content="Full HD" Tag="fullhd"/>
                        <ComboBoxItem Content="4K" Tag="4k"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rezultati -->
        <ListBox x:Name="lstResults" Grid.Row="3" Background="#1A1A1A" Height="300"
                 SelectionMode="Extended"
                 SelectionChanged="lstResults_SelectionChanged"
                 AutomationProperties.Name="Rezultati pretrage">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ThumbnailURL}" Width="120" Height="80" Stretch="Uniform"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="500"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="👍" Foreground="#888"/>
                                    <TextBlock Text="{Binding Likes}" Foreground="#888" Margin="3,0,10,0"/>
                                    <TextBlock Text="👁️" Foreground="#888"/>
                                    <TextBlock Text="{Binding Views}" Foreground="#888" Margin="3,0,10,0"/>
                                    <TextBlock Text="📥" Foreground="#888"/>
                                    <TextBlock Text="{Binding Downloads}" Foreground="#888" Margin="3,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="📷" Foreground="#888" FontSize="10"/>
                                    <TextBlock Text="{Binding Dimensions}" Foreground="#888" FontSize="10" Margin="3,0,10,0"/>
                                    <TextBlock Text="🎬" Foreground="#888" FontSize="10" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding Duration}" Foreground="#888" FontSize="10" Margin="3,0,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding User}" Foreground="#AAA" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Info o odabranim stavkama -->
        <Border Grid.Row="4" Background="#1A3A1A" CornerRadius="4" Padding="8" Margin="0,10,0,10">
            <TextBlock x:Name="txtSelectedInfo" Foreground="#C8E6C9" FontSize="11" TextWrapping="Wrap"
                       Text="Select one or more items (Ctrl+click or Shift+click)"/>
        </Border>

        <!-- Dugmad -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnDownload" Content="📥 DOWNLOAD SELECTED" Click="btnDownload_Click" IsDefault="True"
                    Width="200" Height="35" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                    FontSize="13" FontWeight="Bold" Margin="0,0,10,0"
                    IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="❌ CANCEL" Click="btnCancel_Click" IsCancel="True"
                    Width="100" Height="35" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                    FontSize="13" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
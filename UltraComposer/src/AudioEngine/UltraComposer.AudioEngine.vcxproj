    <ClInclude Include="Style.h" />
    <ClInclude Include="Synth.h" />
    <ClInclude Include="Voice.h" />
    <ClInclude Include="VstHost.h" />
    <ClInclude Include="WavWriter.h" />
    <!-- Vendored TinySoundFont (single-header library, MIT license - see
         thirdparty/tsf/LICENSE.txt). Only SoundFontHost.cpp compiles it
         (with TSF_IMPLEMENTATION defined) - listed here just so it shows
         up in Solution Explorer. -->
    <ClInclude Include="thirdparty\tsf\tsf.h" />
  </ItemGroup>
  <ItemGroup>

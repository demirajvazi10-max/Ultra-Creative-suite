<Window x:Class="UltraVideoEditor.AutoArrangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎬 Auto-arrange images" Height="1000" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBg}"
        AutomationProperties.Name="Dialog for automatic image arrangement">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Text="🎬 AUTO-ARRANGE IMAGES" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Info o audio -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <TextBlock x:Name="txtAudioInfo" Foreground="#88CCFF" TextWrapping="Wrap"/>
        </Border>

        <!-- Trajanje intro teksta -->
        <TextBlock Grid.Row="2" Text="Intro text duration (seconds):" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,3"/>
        <TextBox x:Name="txtIntroDuration" Grid.Row="3" Width="100" Height="30" Text="5" 
                 Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                 AutomationProperties.Name="Intro text duration in seconds"/>

        <!-- Trajanje outro teksta -->
        <TextBlock Grid.Row="4" Text="Outro text duration (seconds):" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,3"/>
        <TextBox x:Name="txtOutroDuration" Grid.Row="5" Width="100" Height="30" Text="7" 
                 Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                 AutomationProperties.Name="Outro text duration in seconds"/>

        <!-- Effect selection mode -->
        <TextBlock Grid.Row="6" Text="Effect selection mode:" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,3"/>
        <ComboBox x:Name="cmbEffectMode" Grid.Row="7" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                  SelectionChanged="EffectMode_Changed"
                  AutomationProperties.Name="Effect mode selection">
            <ComboBoxItem Content="🎲 Automatic (cyclic)"/>
            <ComboBoxItem Content="🎲 Manual (define list)"/>
            <ComboBoxItem Content="🎲 Random"/>
        </ComboBox>

        <!-- Effect list (manual entry) -->
        <TextBlock Grid.Row="8" Text="Effect list (separate with comma):" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,3"/>
        <TextBox x:Name="txtEffectSequence" Grid.Row="9" Height="60" TextWrapping="Wrap" 
                 Text="ZoomIn, SlideLeft, FadeIn, ZoomOut, SlideRight"
                 Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" IsEnabled="False"
                 AutomationProperties.Name="Comma-separated effect list"/>

        <!-- Tekst na slici -->
        <Border Grid.Row="10" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="chkTextOnImage" Content="🎨 Add text to each image" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="False" Margin="0,0,0,5"
                          Checked="ChkTextOnImage_Checked" Unchecked="ChkTextOnImage_Checked"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="Text:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtOverlayText" Width="200" Height="25" Text=""
                             Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" IsEnabled="False" AutomationProperties.Name="Overlay text"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,5,0,0">
                    <CheckBox x:Name="chkUseCounter" Content="Add image number (1,2,3...)" 
                              Foreground="{DynamicResource TextPrimary}" IsChecked="False" IsEnabled="False"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,5,0,0">
                    <TextBlock Text="Font:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbOverlayFont" Width="120" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" IsEnabled="False" AutomationProperties.Name="Overlay font">
                        <ComboBoxItem Content="Arial" IsSelected="True"/>
                        <ComboBoxItem Content="Comic Sans MS"/>
                        <ComboBoxItem Content="Impact"/>
                    </ComboBox>
                    <TextBlock Text="Color:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <ComboBox x:Name="cmbOverlayColor" Width="100" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" IsEnabled="False" AutomationProperties.Name="Overlay text color">
                        <ComboBoxItem Content="⚪ White" Tag="#FFFFFF" IsSelected="True"/>
                        <ComboBoxItem Content="🟡 Yellow" Tag="#FFFF00"/>
                        <ComboBoxItem Content="⚫ Black" Tag="#000000"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Logo -->
        <Border Grid.Row="11" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🏷️ Channel logo" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Logo path:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtLogoPath" Width="250" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Padding="3" AutomationProperties.Name="Logo path"/>
                    <Button x:Name="btnBrowseLogo" Content="📂" Click="btnBrowseLogo_Click" Width="40" Height="25" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" AutomationProperties.Name="Browse for logo file"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkShowLogo" Content="Show logo at start" 
                              Foreground="{DynamicResource TextPrimary}" IsChecked="False" Margin="0,0,20,0"/>
                    <TextBlock Text="Logo duration (s):" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtLogoDuration" Width="50" Height="25" Text="5" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" AutomationProperties.Name="Logo duration in seconds"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Najavni i odjavni tekst -->
        <Border Grid.Row="12" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📝 Texts" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Intro text:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtIntroText" Width="300" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Padding="3"
                             Text="🎵 New children's song" AutomationProperties.Name="Intro text"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Outro text:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtOutroText" Width="300" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Padding="3"
                             Text="👍 Thanks for watching! 🎵 Subscribe!" AutomationProperties.Name="Outro text"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Channel name:" Foreground="{DynamicResource TextPrimary}" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtChannelName" Width="250" Height="25" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Padding="3"
                             Text="Kids World" AutomationProperties.Name="Channel name"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Video resolution -->
        <Border Grid.Row="13" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📹 Video resolution:" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="cmbResolution" Width="150" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Video resolution">
                        <ComboBoxItem Content="📱 1280×720 (HD)" Tag="1280x720"/>
                        <ComboBoxItem Content="📺 1920×1080 (Full HD)" Tag="1920x1080" IsSelected="True"/>
                        <ComboBoxItem Content="🎬 2560×1440 (2K)" Tag="2560x1440"/>
                        <ComboBoxItem Content="🚀 3840×2160 (4K)" Tag="3840x2160"/>
                    </ComboBox>
                    <TextBlock Text=" (higher resolution = larger file)" Foreground="#888" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Intro/outro animation -->
        <Border Grid.Row="14" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="chkAnimateIntro" Content="🎬 Animate intro text" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkAnimateOutro" Content="🎬 Animate outro text" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- PROFESSIONAL EFFECTS -->
        <Border Grid.Row="15" Background="{DynamicResource PanelBg2}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🎬 Professional effects" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkCrossfade" Content="↗ Smooth transitions (crossfade) between images" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,5"
                          AutomationProperties.Name="Enable smooth transitions between images"/>

                <CheckBox x:Name="chkKenBurns" Content="🔍 Ken Burns effect (gentle zoom on images)" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,5"
                          AutomationProperties.Name="Enable Ken Burns zoom effect on images"/>

                <CheckBox x:Name="chkTransitionSounds" Content="🔊 Scene transition sounds (pop/whoosh)" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,5"
                          AutomationProperties.Name="Add sound effects during image transitions"/>

                <CheckBox x:Name="chkAmbientSounds" Content="🌳 Ambient sounds (birds, wind, sea, children)" 
                          Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,5"
                          AutomationProperties.Name="Add ambient sounds based on image content"/>
            </StackPanel>
        </Border>
        <!-- LOCAL SOUND LIBRARY -->
        <Border Grid.Row="16" Background="#1A2A1A" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔊 Local sound library (Assets/Sounds/)" Foreground="#81C784" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock x:Name="txtLocalSoundsInfo" Text="Scanning..." Foreground="#A5D6A7" VerticalAlignment="Center" Width="350"/>
                    <Button x:Name="btnLocalSoundsInfo" Content="ℹ Info" Click="btnLocalSoundsInfo_Click"
                            Width="80" Height="28" Background="#388E3C" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0,0,0"
                            AutomationProperties.Name="Information about the local sound library"/>
                </StackPanel>
                <TextBlock Text="Place MP3/WAV files in Assets/Sounds/ — AI automatically picks a sound based on context"
                           Foreground="#A5D6A7" FontSize="9" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="20" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnApply" Content="🎬 APPLY" Click="Apply_Click" IsDefault="True"
                    Width="120" Height="35" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                    FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="❌ CANCEL" Click="Cancel_Click" IsCancel="True"
                    Width="100" Height="35" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                    FontSize="13" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
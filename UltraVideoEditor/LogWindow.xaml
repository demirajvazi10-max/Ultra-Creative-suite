<Window x:Class="UltraVideoEditor.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Log - Event history" Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBg}"
        AutomationProperties.Name="Window with log message history">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="📋 EVENT HISTORY" FontSize="16" FontWeight="Bold" 
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <Button x:Name="btnCopyAll" Content="📋 COPY ALL" Click="CopyAll_Click"
                    Width="120" Height="30" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="20,0,5,0"/>
            <Button x:Name="btnClear" Content="🗑 CLEAR" Click="Clear_Click"
                    Width="100" Height="30" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
        </StackPanel>

        <ListBox x:Name="lstLog" Grid.Row="1" Background="{DynamicResource ControlBg}" Foreground="#00FF00"
                 FontFamily="Consolas" FontSize="12"
                 AutomationProperties.Name="Log messages list, event history"
                 AutomationProperties.HelpText="Use up/down arrows to navigate messages. Ctrl+C to copy selected message.">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Time}" Width="60" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text=" - " Foreground="Gray"/>
                        <TextBlock Text="{Binding Message}" Foreground="#00FF00" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <!-- Bez static AutomationProperties.Name namerno: kod TextBlock-a se Text
                 automatski koristi kao UIA Name, sto je bas ono sto zelimo da se cita
                 pri live-region najavi. Fiksni Name bi tu automatsku vezu prekinuo
                 (ista greska ispravljena u MainWindow txtJawsLog). -->
            <TextBlock x:Name="txtStatus" Text="Ready" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                       AutomationProperties.LiveSetting="Assertive"/>
            <Button x:Name="btnClose" Content="❌ CLOSE" Click="Close_Click"
                    Width="100" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
			<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyName>UltraVideoEditor</AssemblyName>
		<RootNamespace>UltraVideoEditor</RootNamespace>
		<!-- Jedino mesto koje treba da promeniš pre svakog GitHub release-a/tag-a.
		     Naslov prozora i "About" dijalog čitaju ovu vrednost u runtime-u
		     (MainWindow.xaml.cs -> GetAppVersion()), tako da se nigde više ne
		     ručno kuca broj verzije. -->
		<Version>1.4.5</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LibVLCSharp" Version="3.9.6" />
		<PackageReference Include="LibVLCSharp.WPF" Version="3.9.6" />
		<PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" />
		<PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.6" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- ONNX Runtime — AI computer vision za analizu klipova -->
		<!-- Ako nije instalirano, VisionAnalyzer automatski koristi FFmpeg fallback -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.0" />
		<PackageReference Include="SkiaSharp" Version="2.88.6" />
		<PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.6" />
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
		</ItemGroup>

	<!-- v1.4: the test project lives in the Tests folder and is built on its own -->
	<ItemGroup>
		<Compile Remove="Tests\**" />
		<EmbeddedResource Remove="Tests\**" />
		<None Remove="Tests\**" />
		<Page Remove="Tests\**" />
	</ItemGroup>

	<!-- v1.4.5: backup folders are never built (a .cs or .xaml copy there would be a second definition) -->
	<ItemGroup>
		<Compile Remove="Backup_*\**" />
		<EmbeddedResource Remove="Backup_*\**" />
		<None Remove="Backup_*\**" />
		<Page Remove="Backup_*\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
		<!-- v1.4: third-party licences ship next to the program (Help → Third-party licences) -->
		<None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
		<!-- v1.4: downloads the ambient sound library from Adobe (installer task and Help menu) -->
		<None Update="Tools\DownloadAdobeSounds.ps1" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\Sounds\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
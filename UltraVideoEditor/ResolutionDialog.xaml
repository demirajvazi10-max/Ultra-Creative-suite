<Window x:Class="UltraVideoEditor.ResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select resolution" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBg}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📹 Select video resolution" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ComboBox x:Name="cmbResolution" Grid.Row="1" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20" AutomationProperties.Name="Video resolution">
            <ComboBoxItem Content="📱 1280×720 (HD)" Tag="1280x720" IsSelected="True"/>
            <ComboBoxItem Content="📺 1920×1080 (Full HD)" Tag="1920x1080"/>
            <ComboBoxItem Content="🎬 2560×1440 (2K)" Tag="2560x1440"/>
            <ComboBoxItem Content="🚀 3840×2160 (4K)" Tag="3840x2160"/>
        </ComboBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="✅ CONFIRM" Click="Ok_Click" Width="100" Height="35" IsDefault="True"
                    Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,10,0" AutomationProperties.Name="Confirm resolution"/>
            <Button Content="❌ CANCEL" Click="Cancel_Click" Width="100" Height="35" IsCancel="True"
                    Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}" AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="UltraVideoEditor.YouTubeDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from YouTube"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBg}"
        Foreground="{DynamicResource TextPrimary}"
        AutomationProperties.Name="Dialog for importing video or audio from YouTube">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0  Naslov -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 2  URL -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 4  Tip -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 6  Kvalitet (video ili audio) -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 8  Save to folder -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 10 Add to timeline checkbox -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 12 Info panel (+ playlist track picker) -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 14 Progress -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 16 Dugmici -->
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0"
                   Text="Import from YouTube"
                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <!-- URL -->
        <StackPanel Grid.Row="2">
            <Label Content="YouTube URL (video or playlist):" Target="{Binding ElementName=txtUrl}"/>
            <TextBox x:Name="txtUrl"
                     AutomationProperties.Name="YouTube URL — enter link to video or playlist"
                     AutomationProperties.HelpText="Accepts a link to a single video or an entire playlist"
                     KeyDown="TxtUrl_KeyDown"/>
        </StackPanel>

        <!-- Tip fajla -->
        <GroupBox Grid.Row="4"
                  Header="File type"
                  Foreground="{DynamicResource TextPrimary}" BorderBrush="#555"
                  AutomationProperties.Name="File type selection">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <RadioButton x:Name="rbVideo" Content="Video (MP4)" IsChecked="True"
                             AutomationProperties.Name="Video, MP4 format"
                             Checked="FormatType_Changed"/>
                <RadioButton x:Name="rbAudio" Content="Audio (MP3)"
                             AutomationProperties.Name="Audio, MP3 format"
                             Checked="FormatType_Changed"/>
            </StackPanel>
        </GroupBox>

        <!-- Kvalitet -->
        <StackPanel Grid.Row="6" x:Name="pnlQuality">
            <Label Content="Video quality:" Target="{Binding ElementName=cmbQuality}"/>
            <ComboBox x:Name="cmbQuality"
                      AutomationProperties.Name="Video quality selection"
                      SelectedIndex="0">
                <ComboBoxItem Content="Best available" Tag="best"/>
                <ComboBoxItem Content="1080p" Tag="1080"/>
                <ComboBoxItem Content="720p" Tag="720"/>
                <ComboBoxItem Content="480p" Tag="480"/>
                <ComboBoxItem Content="360p" Tag="360"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" x:Name="pnlAudioQuality" Visibility="Collapsed">
            <Label Content="MP3 quality:" Target="{Binding ElementName=cmbAudioQuality}"/>
            <ComboBox x:Name="cmbAudioQuality"
                      AutomationProperties.Name="MP3 audio quality selection"
                      SelectedIndex="2">
                <ComboBoxItem Content="Best (VBR, largest file)" Tag="0"/>
                <ComboBoxItem Content="320 kbps" Tag="320K"/>
                <ComboBoxItem Content="192 kbps (recommended)" Tag="192K"/>
                <ComboBoxItem Content="128 kbps (smaller file)" Tag="128K"/>
            </ComboBox>
        </StackPanel>

        <!-- Save to folder -->
        <StackPanel Grid.Row="8">
            <Label Content="Save to folder:" Target="{Binding ElementName=txtSaveFolder}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSaveFolder" Grid.Column="0"
                         IsReadOnly="True"
                         AutomationProperties.Name="Destination folder for downloaded file"/>
                <Button x:Name="btnBrowseFolder" Grid.Column="2"
                        Content="Browse..."
                        AutomationProperties.Name="Choose a different destination folder"
                        Click="BtnBrowseFolder_Click"/>
            </Grid>
        </StackPanel>

        <!-- Add to timeline -->
        <CheckBox Grid.Row="10" x:Name="chkAddToTimeline"
                   Content="Add to timeline after download"
                   IsChecked="True"
                   AutomationProperties.Name="Add downloaded file to timeline after download completes"/>

        <!-- Info panel (pojavljuje se nakon fetch-a), sadrži i listu numera za plejliste -->
        <Border Grid.Row="12"
                x:Name="pnlInfo"
                Background="{DynamicResource ControlBg}" BorderBrush="#444" BorderThickness="1"
                CornerRadius="4" Padding="12,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txbInfoTitle"
                           Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="txbInfoMeta"
                           Foreground="#AAA" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel x:Name="pnlPlaylistTracks" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="Choose which track(s) to download (all selected = whole playlist):"
                               Foreground="{DynamicResource TextPrimary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <ListBox x:Name="lstPlaylistTracks"
                             Height="110"
                             SelectionMode="Multiple"
                             AutomationProperties.Name="Playlist tracks — select one or more to download only those, or leave all selected for the whole playlist"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <StackPanel Grid.Row="14" x:Name="pnlProgress" Visibility="Collapsed">
            <ProgressBar x:Name="prgDownload"
                         Height="10" Minimum="0" Maximum="100" Value="0"
                         Background="{DynamicResource ControlBg}" Foreground="#0078D4"
                         AutomationProperties.Name="Download progress"/>
            <!-- Bez static AutomationProperties.Name namerno - vidi napomenu kod
                 txtJawsLog u MainWindow.xaml. -->
            <TextBlock x:Name="txbProgress"
                       Foreground="#AAA" FontSize="12" Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>

        <!-- Dugmici -->
        <Grid Grid.Row="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnFetchInfo"
                    Grid.Column="0"
                    Content="Load info"
                    Style="{StaticResource PrimaryBtn}"
                    AutomationProperties.Name="Load video or playlist information"
                    Click="BtnFetchInfo_Click"/>

            <Button x:Name="btnDownload"
                    Grid.Column="2"
                    Content="Download"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryBtn}"
                    AutomationProperties.Name="Download video or audio"
                    Click="BtnDownload_Click"/>

            <Button x:Name="btnCancel"
                    Grid.Column="4" IsCancel="True"
                    Content="Cancel"
                    Background="#3D3D3D" Foreground="{DynamicResource ButtonTextBrush}" BorderThickness="0"
                    AutomationProperties.Name="Cancel and close dialog"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>

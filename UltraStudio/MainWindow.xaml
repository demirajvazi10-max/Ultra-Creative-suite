<Window x:Class="UltraStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfhost="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:ctrl="clr-namespace:UltraStudio.Controls"
        Title="{DynamicResource L_app_title}" Height="720" Width="1200"
        Background="{StaticResource BrBgDark}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENI — svaka stavka ima Tag = id komande (MainWindow.Commands.cs) -->
        <Menu Grid.Row="0" Background="{StaticResource BrBgPanel}" Foreground="{StaticResource BrText}">
            <MenuItem Header="{DynamicResource L_menu_file}">
                <MenuItem Header="{DynamicResource L_menu_new_canvas}" Tag="new" Click="Menu_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="{DynamicResource L_menu_open}" Tag="open" Click="Menu_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_save_project}" Tag="save" Click="Menu_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="{DynamicResource L_menu_save_project_as}" Tag="saveas" Click="Menu_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_export}" Tag="export" Click="Menu_Click" InputGestureText="Ctrl+E"/>
                <MenuItem Header="{DynamicResource L_menu_batch}" Tag="batch" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_exit}" Tag="exit" Click="Menu_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_edit}">
                <MenuItem Header="{DynamicResource L_menu_undo}" Tag="undo" Click="Menu_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{DynamicResource L_menu_redo}" Tag="redo" Click="Menu_Click" InputGestureText="Ctrl+Y"/>
                <MenuItem Header="{DynamicResource L_menu_history}" Tag="history" Click="Menu_Click" InputGestureText="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_copy_to_layer}" Tag="copylayer" Click="Menu_Click" InputGestureText="Ctrl+J"/>
                <MenuItem Header="{DynamicResource L_menu_cut_to_layer}" Tag="cutlayer" Click="Menu_Click" InputGestureText="Ctrl+Shift+J"/>
                <MenuItem Header="{DynamicResource L_menu_fill_selection}" Tag="fill" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_delete_selection}" Tag="clear" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_design_check}" Tag="designcheck" Click="Menu_Click" InputGestureText="F7"/>
                <MenuItem Header="{DynamicResource L_menu_quick_status}" Tag="status" Click="Menu_Click" InputGestureText="F6"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_language}" Tag="language" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_select}">
                <MenuItem Header="{DynamicResource L_menu_select_all}" Tag="selall" Click="Menu_Click" InputGestureText="Ctrl+A"/>
                <MenuItem Header="{DynamicResource L_menu_deselect}" Tag="deselect" Click="Menu_Click" InputGestureText="Ctrl+D"/>
                <MenuItem Header="{DynamicResource L_menu_invert_selection}" Tag="selinvert" Click="Menu_Click" InputGestureText="Ctrl+Shift+I"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_select_rect}" Tag="selrect" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_select_ellipse}" Tag="selellipse" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_select_preset}" Tag="selpreset" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_select_subject}" Tag="selsubject" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_select_describe}" Tag="seldescribe" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_color_range}" Tag="colorrange" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_feather}" Tag="feather" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_selection_info}" Tag="selinfo" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_whats_in_selection}" Tag="selwhat" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_image}">
                <MenuItem Header="{DynamicResource L_menu_crop_selection}" Tag="cropsel" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_crop_ratio}" Tag="cropratio" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_crop_numbers}" Tag="cropnum" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_image_size}" Tag="imagesize" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_canvas_size}" Tag="canvassize" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_rotate_cw}" Tag="rot90" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_rotate_ccw}" Tag="rot270" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_rotate_180}" Tag="rot180" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_rotate_any}" Tag="rotany" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_flip_h}" Tag="fliph" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_flip_v}" Tag="flipv" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_flatten}" Tag="flatten" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_adjust}">
                <MenuItem Header="{DynamicResource L_menu_looks}" Tag="looks" Click="Menu_Click" InputGestureText="Ctrl+L"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_auto_tone}" Tag="autotone" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_auto_contrast}" Tag="autocontrast" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_auto_color}" Tag="autocolor" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_ai_suggest}" Tag="aisuggest" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_bake}" Tag="bake" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_reset}" Tag="reset" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_filter}">
                <MenuItem Header="{DynamicResource L_menu_repeat_filter}" Tag="refilter" Click="Menu_Click" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_flt_GaussianBlur}" Tag="filter:GaussianBlur" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_MotionBlur}" Tag="filter:MotionBlur" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_SpinBlur}" Tag="filter:SpinBlur" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_UnsharpMask}" Tag="filter:UnsharpMask" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_AddNoise}" Tag="filter:AddNoise" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_ReduceNoise}" Tag="filter:ReduceNoise" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_flt_Emboss}" Tag="filter:Emboss" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_FindEdges}" Tag="filter:FindEdges" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_OilPaint}" Tag="filter:OilPaint" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Sketch}" Tag="filter:Sketch" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Charcoal}" Tag="filter:Charcoal" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Pixelate}" Tag="filter:Pixelate" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Solarize}" Tag="filter:Solarize" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_flt_Swirl}" Tag="filter:Swirl" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Wave}" Tag="filter:Wave" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_flt_Pinch}" Tag="filter:Pinch" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_retouch}">
                <MenuItem Header="{DynamicResource L_menu_remove_object}" Tag="removeobj" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_remove_selected}" Tag="removesel" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_spot_heal}" Tag="spot" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_redeye_ai}" Tag="redeyeai" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_redeye_sel}" Tag="redeyesel" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_ai}">
                <MenuItem Header="{DynamicResource L_ai_describe_btn}" Tag="describe" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_describe_look}" Tag="describelook" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_whats_in_selection}" Tag="selwhat" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_remove_bg}" Tag="removebg" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_replace_bg_color}" Tag="bgcolor" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_replace_bg_image}" Tag="bgimage" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_blur_bg}" Tag="bgblur" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_extract_object}" Tag="extract" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_select_subject}" Tag="selsubject" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_layers}">
                <MenuItem Header="{DynamicResource L_menu_add_text_layer}" Tag="addtext" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_add_shape_layer}">
                    <MenuItem Header="{DynamicResource L_shape_rectangle}" Tag="addrect" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_shape_ellipse}" Tag="addellipse" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_shape_line}" Tag="addline" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource L_menu_add_image_layer}" Tag="addimage" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_add_gradient_layer}" Tag="addgradient" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_layer_properties}" Tag="layerprops" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_duplicate_layer}" Tag="duplayer" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_delete_layer}" Tag="dellayer" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_move_layer_up}" Tag="layerup" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_move_layer_down}" Tag="layerdown" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_arrange}">
                    <MenuItem Header="{DynamicResource L_arr_center_h}" Tag="arr:ch" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_center_v}" Tag="arr:cv" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_center}" Tag="arr:c" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource L_arr_left}" Tag="arr:l" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_right}" Tag="arr:r" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_top}" Tag="arr:t" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_bottom}" Tag="arr:b" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource L_arr_fill}" Tag="arr:fill" Click="Menu_Click"/>
                    <MenuItem Header="{DynamicResource L_arr_where}" Tag="arr:where" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource L_menu_layer_where}" Tag="arr:where" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_flatten}" Tag="flatten" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_document}">
                <MenuItem Header="{DynamicResource L_menu_page_new}" Tag="pagenew" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_page_new_size}" Tag="pagenewsize" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_page_duplicate}" Tag="pagedup" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_page_delete}" Tag="pagedel" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_page_prev}" Tag="pageprev" Click="Menu_Click" InputGestureText="Ctrl+PageUp"/>
                <MenuItem Header="{DynamicResource L_menu_page_next}" Tag="pagenext" Click="Menu_Click" InputGestureText="Ctrl+PageDown"/>
                <MenuItem Header="{DynamicResource L_menu_page_list}" Tag="pagelist" Click="Menu_Click" InputGestureText="Ctrl+G"/>
                <MenuItem Header="{DynamicResource L_menu_page_up}" Tag="pageup" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_page_down}" Tag="pagedown" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_flow_text}" Tag="flowtext" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_add_frame}" Tag="addframe" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_page_numbers}" Tag="pagenumbers" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_doc_dpi}" Tag="docdpi" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_export_pdf}" Tag="exportpdf" Click="Menu_Click" InputGestureText="Ctrl+Shift+E"/>
                <MenuItem Header="{DynamicResource L_menu_export_pages}" Tag="exportpages" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_proofread}">
                <MenuItem Header="{DynamicResource L_menu_proofread_document}" Tag="proofdoc" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_proofread_all}" Tag="proofall" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_typography}" Tag="typo" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_to_cyrillic}" Tag="tocyr" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_to_latin}" Tag="tolat" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_typography_file}" Tag="typodoc" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_help}">
                <MenuItem Header="{DynamicResource L_menu_shortcuts}" Tag="shortcuts" Click="Menu_Click" InputGestureText="F1"/>
                <MenuItem Header="{DynamicResource L_menu_log}" Tag="log" Click="Menu_Click" InputGestureText="Ctrl+Shift+L"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_support}" Tag="support" Click="Menu_Click"/>
                <MenuItem Header="{DynamicResource L_menu_about}" Tag="about" Click="Menu_Click"/>
            </MenuItem>
        </Menu>

        <!-- MOD PREBACIVANJE — Vizuelni (mišem/sliderima, za sighted korisnike)
             naspram JAWS (native ListView, tastatura). Isti obrazac kao Ultra
             Audio Editor (Alt+W). Obe strane pišu u isti ImageProject, ništa
             se ne duplira u logici, samo u prikazu. -->
        <Border Grid.Row="1" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnVisualMode"
                            Content="{DynamicResource L_visual_mode_btn}"
                            Style="{StaticResource StdButton}"
                            Click="BtnVisualMode_Click"
                            Margin="4,2,0,2"
                            AutomationProperties.Name="{DynamicResource L_acc_switch_visual}"
                            ToolTip="{DynamicResource L_visual_mode_tt}"/>
                    <Button x:Name="BtnJawsMode"
                            Content="{DynamicResource L_jaws_mode_btn}"
                            Style="{StaticResource AIButton}"
                            Click="BtnJawsMode_Click"
                            Margin="4,2,0,2"
                            AutomationProperties.Name="{DynamicResource L_acc_switch_jaws}"
                            ToolTip="{DynamicResource L_jaws_mode_tt}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           x:Name="CurrentModeLabel"
                           Text="{DynamicResource L_jaws_mode_indicator}"
                           FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource BrTextMuted}"
                           Margin="0,0,8,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>

        <!-- GLAVNI SADRZAJ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEVO: DVA moda, jedan vidljiv u datom trenutku. Ispod podesavanja
                 dodata je i sekcija SLOJEVA (grafi cki dizajn deo) — isti
                 dual JAWS/Visual obrazac, samo za drugu listu podataka. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource BrBgPanel}"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1" Padding="8,5">
                    <TextBlock x:Name="TxtImageInfo" FontSize="11" Foreground="{StaticResource BrText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Border>

                <!-- JAWS MOD: pristupacna lista podesavanja (native Win32 ListView —
                     isti dokazan obrazac kao Audio Editor-ova lista traka) -->
                <wfhost:WindowsFormsHost Grid.Row="1" x:Name="wfhAdjustments" Margin="2">
                    <ctrl:TabAwareListView x:Name="nativeAdjustList"
                                 View="Details"
                                 FullRowSelect="True"
                                 GridLines="False"
                                 HideSelection="False"
                                 MultiSelect="False"
                                 AutoArrange="True"/>
                </wfhost:WindowsFormsHost>

                <!-- VIZUELNI MOD: pravi WPF sliderи i checkbox-ovi, misem-prevlacivi,
                     za sighted korisnike koji ocekuju standardan photo-editor izgled. -->
                <ScrollViewer Grid.Row="1" x:Name="VisualAdjustPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="VisualAdjustStack"/>
                </ScrollViewer>

                <!-- NASLOV SEKCIJE SLOJEVA -->
                <Border Grid.Row="2" Background="{StaticResource BrBgPanel}"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="0,1,0,1" Padding="8,5">
                    <TextBlock Text="{DynamicResource L_layers_header}" FontWeight="Bold"
                               Foreground="{StaticResource BrAccent}" FontSize="11"/>
                </Border>

                <!-- JAWS MOD: pristupacna lista slojeva -->
                <wfhost:WindowsFormsHost Grid.Row="3" x:Name="wfhLayers" Margin="2">
                    <ctrl:TabAwareListView x:Name="nativeLayerList"
                                 View="Details"
                                 FullRowSelect="True"
                                 GridLines="False"
                                 HideSelection="False"
                                 MultiSelect="False"
                                 AutoArrange="True"/>
                </wfhost:WindowsFormsHost>

                <!-- VIZUELNI MOD: lista slojeva sa dugmicima za vidljivost/redosled/opacity -->
                <ScrollViewer Grid.Row="3" x:Name="VisualLayerPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="VisualLayerStack"/>
                </ScrollViewer>
            </Grid>

            <!-- DESNO: prikaz slike + AI panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0F0F1A" Margin="8">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove"
                               MouseLeftButtonUp="Preview_MouseUp"
                               AutomationProperties.Name="{DynamicResource L_acc_preview}"/>
                        <TextBlock x:Name="TxtNoImage" Text="{DynamicResource L_no_image_hint}"
                                   Foreground="{StaticResource BrTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- AI PANEL -->
                <Border Grid.Row="1" Background="{StaticResource BrBgPanel}"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="0,1,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource L_ai_panel_header}"
                                   FontWeight="Bold" Foreground="#4ECFA0" Margin="0,0,0,6"/>
                        <Button Grid.Row="1" x:Name="BtnDescribe" Content="{DynamicResource L_ai_describe_btn}"
                                Style="{StaticResource AIButton}" HorizontalAlignment="Left"
                                Width="200" Click="BtnDescribe_Click"/>
                        <TextBox Grid.Row="2" x:Name="TxtAiResult" Margin="0,8,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{DynamicResource L_ai_result_placeholder}"
                                 AutomationProperties.Name="AI description result"
                                 AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="3" Background="{StaticResource BrBgPanel}">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusMessage" Foreground="{StaticResource BrText}" FontSize="11"
                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StatusBarItem>
        </StatusBar>

        <!-- BANER MODA — kratka, animirana, samonestajuća potvrda pri pokretanju
             ("JAWS Mode active" / "Visual Mode active"). Čisto vizuelna potvrda;
             najava za čitače ekrana ide odvojeno preko statusne trake (live
             region), pa se ova dva ne preklapaju/ne dupliraju u govoru JAWS-a.
             IsHitTestVisible="False" da nikad ne smeta klikovima ispod sebe. -->
        <Border x:Name="ModeToast" Grid.Row="0" Grid.RowSpan="4"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,66,0,0" Padding="16,10"
                Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1"
                CornerRadius="8" Opacity="0" Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ModeToastDot" Width="9" Height="9" Fill="{StaticResource BrAccent}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ModeToastText" FontSize="12.5" Foreground="{StaticResource BrText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

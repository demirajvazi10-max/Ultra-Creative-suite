<Window x:Class="UltraVideoEditor.MediaProvidersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 Media Providers — API Keys"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A2E"
        AutomationProperties.Name="Media Providers Settings Dialog">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00E676"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ApiTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444466"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="StatusBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="🌐 Media Providers"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#00E676"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="System searches providers in order: Pixabay → Pexels → Coverr"
                       FontSize="11" Foreground="#78909C" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Scroll area sa provajderima -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══ PIXABAY ══ -->
                <Border Background="#1E1E30" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Pixabay"
                                       Margin="0,0,0,0"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock x:Name="txtPixabayStatus"
                                       Style="{StaticResource StatusBadge}"
                                       Text="● Not configured"
                                       Foreground="#EF5350"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}"
                                   Text="Primary provider. Free, 5000 req/hour. Video + images."/>

                        <TextBlock Style="{StaticResource Label}" Text="API key:" Margin="0,8,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPixabayKey"
                                     Style="{StaticResource ApiTextBox}"
                                     AutomationProperties.Name="Pixabay API key"
/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button x:Name="btnPixabaySave"
                                        Style="{StaticResource ActionBtn}"
                                        Content="💾 Save"
                                        Background="#2E7D32" Foreground="White"
                                        Click="BtnPixabaySave_Click"
                                        AutomationProperties.Name="Save Pixabay key"
                                        Margin="0,0,4,0"/>
                                <Button x:Name="btnPixabayDelete"
                                        Style="{StaticResource ActionBtn}"
                                        Content="🗑"
                                        Background="#5D2D2D" Foreground="White"
                                        Click="BtnPixabayDelete_Click"
                                        AutomationProperties.Name="Delete Pixabay key"
                                        ToolTip="Delete key — deactivates Pixabay"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,5,0,0">
                            <Hyperlink x:Name="lnkPixabay"
                                       NavigateUri="https://pixabay.com/api/docs/"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#2196F3">
                                Where to get key → pixabay.com/api/docs
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ══ PEXELS ══ -->
                <Border Background="#1E1E30" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Pexels"
                                       Margin="0,0,0,0"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock x:Name="txtPexelsStatus"
                                       Style="{StaticResource StatusBadge}"
                                       Text="● Not configured"
                                       Foreground="#EF5350"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}"
                                   Text="Fallback provider. Free, 200 req/hour. Excellent children's content library."/>

                        <TextBlock Style="{StaticResource Label}" Text="API key:" Margin="0,8,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPexelsKey"
                                     Style="{StaticResource ApiTextBox}"
                                     AutomationProperties.Name="Pexels API key"
/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button x:Name="btnPexelsSave"
                                        Style="{StaticResource ActionBtn}"
                                        Content="💾 Save"
                                        Background="#2E7D32" Foreground="White"
                                        Click="BtnPexelsSave_Click"
                                        AutomationProperties.Name="Save Pexels key"
                                        Margin="0,0,4,0"/>
                                <Button x:Name="btnPexelsDelete"
                                        Style="{StaticResource ActionBtn}"
                                        Content="🗑"
                                        Background="#5D2D2D" Foreground="White"
                                        Click="BtnPexelsDelete_Click"
                                        AutomationProperties.Name="Delete Pexels key"
                                        ToolTip="Delete key — deactivates Pexels"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,5,0,0">
                            <Hyperlink x:Name="lnkPexels"
                                       NavigateUri="https://www.pexels.com/api/new/"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#2196F3">
                                Where to get key → pexels.com/api/new
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ══ COVERR ══ -->
                <Border Background="#1A1A28" CornerRadius="6" Padding="14,10"
                        Margin="0,0,0,8" Opacity="0.7">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Coverr"
                                       Margin="0,0,0,0"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock x:Name="txtCoverrStatus"
                                       Style="{StaticResource StatusBadge}"
                                       Text="● Not configured"
                                       Foreground="#EF5350"/>
                            <TextBlock Text="  (uskoro)"
                                       FontSize="10" Foreground="#546E7A"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}"
                                   Text="Third fallback. Free lifestyle/children's content. Integration in progress."/>

                        <TextBlock Style="{StaticResource Label}" Text="API key:" Margin="0,8,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCoverrKey"
                                     Style="{StaticResource ApiTextBox}"
                                     AutomationProperties.Name="Coverr API key"
/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button x:Name="btnCoverrSave"
                                        Style="{StaticResource ActionBtn}"
                                        Content="💾 Save"
                                        Background="#2E7D32" Foreground="White"
                                        Click="BtnCoverrSave_Click"
                                        AutomationProperties.Name="Save Coverr key"
                                        Margin="0,0,4,0"/>
                                <Button x:Name="btnCoverrDelete"
                                        Style="{StaticResource ActionBtn}"
                                        Content="🗑"
                                        Background="#5D2D2D" Foreground="White"
                                        Click="BtnCoverrDelete_Click"
                                        AutomationProperties.Name="Delete Coverr key"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://coverr.co/api"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#546E7A">
                                More information → coverr.co/api
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ JSON PROVIDERS (user extensions) ══ -->
        <Border Grid.Row="1" Background="#141420" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,0"
                VerticalAlignment="Bottom">
            <StackPanel>
                <TextBlock Text="➕ Add new provider"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#FFB300" Margin="0,0,0,4"
                           AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#78909C"
                           Text="Download an .iskraprovider file and place it in the folder below. Iskra will automatically load it on next start."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnOpenFolder"
                            Content="📁 Open providers folder"
                            Height="30" Padding="12,0"
                            Background="#37474F" Foreground="White"
                            BorderThickness="0" FontSize="11"
                            Click="BtnOpenFolder_Click"
                            AutomationProperties.Name="Open folder where provider files are placed"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnReload"
                            Content="🔄 Refresh"
                            Height="30" Padding="12,0"
                            Background="#1B5E20" Foreground="White"
                            BorderThickness="0" FontSize="11"
                            Click="BtnReload_Click"
                            AutomationProperties.Name="Refresh provider list without restart"
                            ToolTip="Load new .iskraprovider files without restarting the application"/>
                </StackPanel>
                <TextBlock x:Name="txtJsonProviders"
                           FontSize="11" Foreground="#546E7A"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="txtInfo"
                       FontSize="11" Foreground="#78909C"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Keys are stored encrypted on this computer. The system automatically switches to the next provider if the current one has no results."/>
            <Button x:Name="btnClose"
                    Content="✓ Close"
                    Height="34" Width="120"
                    HorizontalAlignment="Right"
                    Background="#1565C0" Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    BorderThickness="0"
                    Click="BtnClose_Click"
                    AutomationProperties.Name="Close dialog"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

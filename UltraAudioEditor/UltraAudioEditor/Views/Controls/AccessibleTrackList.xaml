<UserControl x:Class="UltraAudioEditor.Views.Controls.AccessibleTrackList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             xmlns:wfhost="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             AutomationProperties.Name="{DynamicResource L_acc_workspace}">
    <Grid Background="{StaticResource BrBgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status traka -->
        <Border Grid.Row="0" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel>
                <TextBlock x:Name="TxtProjectStatus" FontSize="11"
                           Foreground="{StaticResource BrText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="TxtPlayhead" FontSize="11" Foreground="#4ECFA0" Margin="0,2,0,0"
                           AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="TxtSelection" FontSize="11" Foreground="#9D8FFF" Margin="0,2,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>

        <!-- PLAYHEAD PANEL — slajder koji se pomjera strelicama -->
        <Border Grid.Row="1" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1"
                AutomationProperties.Name="{DynamicResource L_acc_playhead_help}"
                AutomationProperties.LiveSetting="Polite">
            <StackPanel x:Name="PlayheadPanel"/>
        </Border>

        <!-- JEDINA lista: sve trake i svi klipovi u jednoj ravnoj Win32 ListView tabeli.
             Isti obrazac kao Video Editor (WindowsFormsHost + wf:ListView) — pravi Win32
             SysListView32 kontrolu koju JAWS/NVDA čitaju nativno, bez custom koda. -->
        <Border Grid.Row="2" Background="{StaticResource BrBgDark}">
            <wfhost:WindowsFormsHost x:Name="wfhList" Margin="2">
                <wf:ListView x:Name="nativeListView"
                             View="Details"
                             FullRowSelect="True"
                             GridLines="False"
                             HideSelection="False"
                             MultiSelect="True"
                             AutoArrange="True"/>
            </wfhost:WindowsFormsHost>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="UltraVideoEditor.SceneReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scene review" Height="620" Width="820" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBg}">
    <!--
        v1.4 Scene review — shown after all clips are downloaded, before the video is built.
        Accessibility: the list is the first focus. Each item's accessible name is the full
        sentence (lyric, what the clip shows, score, search words), so JAWS/NVDA read
        everything with the arrow keys. Status changes are announced via a polite live region.
        Keyboard: Enter in the search box = find another clip; access keys (Alt+letter) come from the translated button labels.
        Escape = cancel.
    -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtInstructions" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                   Text="Use the arrow keys to move through the scenes."/>

        <ListBox x:Name="lstScenes" Grid.Row="1"
                 Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"
                 SelectionChanged="lstScenes_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Scenes"/>

        <TextBlock x:Name="lblQuery" Grid.Row="2" Text="Search words for the selected scene:"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,4"/>

        <DockPanel Grid.Row="3" LastChildFill="True">
            <Button x:Name="btnOpenClip" DockPanel.Dock="Right" Content="_Open clip" Width="120" Height="30" Margin="8,0,0,0"
                    Click="btnOpenClip_Click"
                    Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button x:Name="btnReroll" DockPanel.Dock="Right" Content="_Find another clip" Width="160" Height="30" Margin="8,0,0,0"
                    Click="btnReroll_Click"
                    Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
            <TextBox x:Name="txtQuery" Height="30" Padding="4,0" VerticalContentAlignment="Center"
                     Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"
                     PreviewKeyDown="txtQuery_KeyDown"
                     AutomationProperties.LabeledBy="{Binding ElementName=lblQuery}"/>
        </DockPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="4" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondary}" Text=""
                   AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnBuild" Content="_Build video" Width="140" Height="34" Margin="0,0,10,0"
                    Click="btnBuild_Click"
                    Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="34" IsCancel="True"
                    Click="btnCancel_Click"
                    Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UltraVideoEditor.HighlightCreatorDialogV2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Highlight Engine v2"
        Width="820" Height="780"
        MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1A1A2E"
        AutomationProperties.Name="AI Highlight Engine dialog v2">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"      Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#9D5FFF"/>
        <SolidColorBrush x:Key="SurfaceBrush"     Color="#16213E"/>
        <SolidColorBrush x:Key="CardBrush"        Color="#0F3460"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMutedBrush"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderBrush"      Color="#334155"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2D3748"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CaretBrush"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🎬  AI Highlight Engine v2"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Multi-frame arc scoring · Beat-sync rezovi · Preview · Render"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Unos fajlova -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="📹  Video file"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button x:Name="BtnPickVideo" DockPanel.Dock="Right"
                                Content="Browse" Style="{StaticResource SecondaryButton}"
                                Padding="12,7" Margin="6,0,0,0"
                                Click="BtnPickVideo_Click"
                                AutomationProperties.Name="Select video file"/>
                        <TextBox x:Name="TxtVideoPath" Style="{StaticResource InputBox}"
                                 IsReadOnly="True" Text="Not selected…"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 AutomationProperties.Name="Video file path"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ChkUseMusic" DockPanel.Dock="Left"
                                  Content="🎵  Audio file (song)"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  FontSize="12" VerticalAlignment="Center"
                                  IsChecked="True"
                                  Checked="ChkUseMusic_Changed"
                                  Unchecked="ChkUseMusic_Changed"
                                  AutomationProperties.Name="Add music to highlight"/>
                    </DockPanel>
                    <DockPanel x:Name="MusicPanel">
                        <Button x:Name="BtnPickMusic" DockPanel.Dock="Right"
                                Content="Browse" Style="{StaticResource SecondaryButton}"
                                Padding="12,7" Margin="6,0,0,0"
                                Click="BtnPickMusic_Click"
                                AutomationProperties.Name="Select audio file"/>
                        <TextBox x:Name="TxtMusicPath" Style="{StaticResource InputBox}"
                                 IsReadOnly="True" Text="Not selected…"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 AutomationProperties.Name="Audio file path"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Export opcije -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="💾  Output video"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button x:Name="BtnPickOutput" DockPanel.Dock="Right"
                                Content="…" Style="{StaticResource SecondaryButton}"
                                Padding="10,7" Margin="6,0,0,0"
                                Click="BtnPickOutput_Click"
                                AutomationProperties.Name="Select output path"/>
                        <TextBox x:Name="TxtOutputPath" Style="{StaticResource InputBox}"
                                 Text="highlight_output.mp4"
                                 AutomationProperties.Name="Output video path"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="📐  Resolution"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbResolution"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Padding="10,7" Width="130"
                              AutomationProperties.Name="Output video resolution">
                        <ComboBoxItem Content="1920x1080 (FHD)" Tag="1920x1080" IsSelected="True"/>
                        <ComboBoxItem Content="1280x720 (HD)"   Tag="1280x720"/>
                        <ComboBoxItem Content="3840x2160 (4K)"  Tag="3840x2160"/>
                        <ComboBoxItem Content="1080x1920 (9:16)" Tag="1080x1920"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Bottom">
                    <TextBlock Text="⚡  Encoding"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkUseGPU" Content="GPU (NVENC)" IsChecked="True"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                              AutomationProperties.Name="Use GPU NVENC encoding"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button x:Name="BtnRender" Content="🎬 Render"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="BtnRender_Click"
                            AutomationProperties.Name="Start render"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <Border Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="TxtProgressPct" Text="0%"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtProgressMsg" Text="Starting…"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressBar" Height="6"
                             Minimum="0" Maximum="100"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource BorderBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,12">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
                    <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="FontSize"        Value="13"/>
                    <Setter Property="Padding"         Value="14,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Preview -->
            <TabItem Header="🎞  Preview segmenata"
                     AutomationProperties.Name="Preview of selected segments">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Background="{StaticResource CardBrush}"
                               LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Margin="8,4">
                            <Button x:Name="BtnSelectAll" Content="All"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="10,4" Margin="0,0,6,0"
                                    IsEnabled="False" Click="BtnSelectAll_Click"
                                    AutomationProperties.Name="Select all segments"/>
                            <Button x:Name="BtnDeselectAll" Content="None"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="10,4"
                                    IsEnabled="False" Click="BtnDeselectAll_Click"
                                    AutomationProperties.Name="Deselect all segments"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSegmentCount" Text="No segments"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="12,8"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="10,8">
                        <StackPanel x:Name="SegmentsPanel"
                                    AutomationProperties.Name="Lista highlight segmenata"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 2: Izvestaj -->
            <TabItem Header="📋  Report"
                     AutomationProperties.Name="Text analysis report">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Background="{StaticResource CardBrush}"
                               LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Margin="8,4">
                            <Button x:Name="BtnCopyReport" Content="Kopiraj"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="10,4" Margin="0,0,6,0"
                                    Visibility="Collapsed" Click="BtnCopyReport_Click"
                                    AutomationProperties.Name="Copy report"/>
                            <Button x:Name="BtnExport" Content="Save .txt"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="10,4"
                                    Visibility="Collapsed" Click="BtnExport_Click"
                                    AutomationProperties.Name="Save report"/>
                        </StackPanel>
                        <TextBlock Text="Complete analysis report"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="12,8" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox x:Name="TxtReport" Grid.Row="1"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="12"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="The report will appear here after analysis."
                             AutomationProperties.Name="Text analysis report"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Dugmici -->
        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button x:Name="BtnCancel" DockPanel.Dock="Right"
                    Content="Close" Style="{StaticResource SecondaryButton}"
                    Padding="16,9" Click="BtnCancel_Click"
                    AutomationProperties.Name="Close dialog"/>
            <Button x:Name="BtnApplyToTimeline" DockPanel.Dock="Right"
                    Content="✅ Add to timeline"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,9" Margin="0,0,8,0" IsEnabled="False"
                    Click="BtnApplyToTimeline_Click"
                    AutomationProperties.Name="Add segments to timeline"/>
            <Button x:Name="BtnAnalyze" DockPanel.Dock="Left"
                    Content="🔍 Analiziraj video"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,9" IsEnabled="False"
                    Click="BtnAnalyze_Click"
                    AutomationProperties.Name="Start AI analysis"/>
        </DockPanel>
    </Grid>
</Window>
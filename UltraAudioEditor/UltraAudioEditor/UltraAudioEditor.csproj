<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UltraAudioEditor</AssemblyName>
    <RootNamespace>UltraAudioEditor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsForms + UseWPF zajedno navode SDK da automatski doda GLOBALNI
         "using System.Windows.Forms;" u SVAKI fajl projekta (jer je ImplicitUsings
         enable), što se sudara sa WPF-ovim sopstvenim globalnim using-ima
         (Color, Application, UserControl, KeyEventArgs, TextBox, CheckBox...).
         Uklanjamo TAJ globalni using — AccessibleTrackList.xaml.cs i dalje ima
         pristup WinForms tipovima preko sopstvenog "using WF = System.Windows.Forms;"
         alias-a na vrhu fajla, pa mu ovo ne smeta. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Audio engine -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- HTTP / AI -->
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Folder picker bez WinForms konflikta -->
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>
</Project>

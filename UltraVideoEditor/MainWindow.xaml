<Window x:Class="UltraVideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UltraVideoEditor"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfhost="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="ULTRA VIDEO EDITOR v1.0" Height="950" Width="1400" 
        Background="{DynamicResource MainWindowBg}"
        WindowStartupLocation="CenterScreen"
        Focusable="True">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0,0,0,5" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Main menu">
            <MenuItem x:Name="mnuFile" Tag="mw_file_menu">
                <MenuItem x:Name="mnuNew" Tag="mw_new" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem x:Name="mnuOpen" Tag="mw_open" InputGestureText="Ctrl+O" Click="LoadProject_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSave" Tag="menu_save_project" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem x:Name="mnuSaveAs" Tag="menu_save_as" InputGestureText="F12" Click="SaveAsProject_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuExport" Tag="mw_export" InputGestureText="Ctrl+E" Click="FinalRender_Click"/>
                <MenuItem x:Name="mnuExportOptions" Tag="mnu_export_options" Click="ShowExportOptions_Click"/>
                <MenuItem x:Name="mnuExportMulti" Tag="📱|mnu_export_multi" Click="ExportMultiFormat_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuExit" Tag="mnu_exit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuEdit" Tag="mw_edit_menu">
                <MenuItem x:Name="mnuUndo" Tag="menu_undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem x:Name="mnuRedo" Tag="mnu_redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuCut" Tag="cut" InputGestureText="Ctrl+X" Click="CutClip_Click"/>
                <MenuItem x:Name="mnuCopy" Tag="copy" InputGestureText="Ctrl+C" Click="CopyClip_Click"/>
                <MenuItem x:Name="mnuPaste" Tag="paste" InputGestureText="Ctrl+V" Click="PasteClip_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuCutAllMarkers" Tag="mw_cut_all_markers2" InputGestureText="Ctrl+Shift+X" Click="CutAtAllMarkers_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuDeleteSelected" Tag="menu_delete_selected" InputGestureText="Del" Click="RemoveFromTimeline_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSelectAll" Tag="mnu_select_all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuView" Tag="mw_view_menu">
                <MenuItem x:Name="mnuZoomIn" Tag="menu_zoom_in" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem x:Name="mnuZoomOut" Tag="mnu_zoom_out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem x:Name="mnuResetZoom" Tag="mnu_reset_zoom" InputGestureText="Ctrl+0" Click="ResetZoom_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuShowAllTracks" Tag="menu_show_all_tracks" Click="ShowAllTracks_Click"/>
                <MenuItem x:Name="mnuShowVideoOnly" Tag="menu_show_video_only" Click="ShowVideoTracksOnly_Click"/>
                <MenuItem x:Name="mnuShowAudioOnly" Tag="menu_show_audio_only" Click="ShowAudioTracksOnly_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuDisplayMode" Tag="mnu_display_mode">
                    <MenuItem x:Name="mnuModeSighted" Tag="mode_sighted" IsCheckable="True" Click="SetModeSighted_Click"/>
                    <MenuItem x:Name="mnuModeAccessibility" Tag="mode_accessibility" InputGestureText="Ctrl+Shift+A" IsCheckable="True" Click="SetModeAccessibility_Click"/>
                    <MenuItem x:Name="mnuModeLowVision" Tag="mode_low_vision" IsCheckable="True" Click="SetModeLowVision_Click"/>
                    <Separator/>
                    <MenuItem x:Name="mnuLowVisionTextInc" Tag="mode_low_vision_text_inc" InputGestureText="Ctrl+Shift+Plus" Click="IncreaseLowVisionTextSize_Click"/>
                    <MenuItem x:Name="mnuLowVisionTextDec" Tag="mode_low_vision_text_dec" InputGestureText="Ctrl+Shift+Minus" Click="DecreaseLowVisionTextSize_Click"/>
                </MenuItem>
                <MenuItem x:Name="mnuLogWindow" Tag="mnu_log_window" InputGestureText="Ctrl+Shift+L" Click="ShowLogWindow_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuLanguage" Tag="mnu_language">
                    <MenuItem Header="Srpski" Click="SetLanguageSerbian_Click"/>
                    <MenuItem Header="English" Click="SetLanguageEnglish_Click"/>
                    <MenuItem Header="Deutsch" Click="SetLanguageGerman_Click"/>
                </MenuItem>
                <MenuItem x:Name="mnuTheme" Tag="mnu_theme">
                    <MenuItem Header="🌙 Dark" Click="SetThemeDark_Click"/>
                    <MenuItem Header="⚡ High contrast" Click="SetThemeContrast_Click"/>
                    <MenuItem Header="☀️ Light" Click="SetThemeLight_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="mnuTimeline" Tag="mw_timeline_menu">
                <MenuItem x:Name="mnuAddVideo" Tag="mnu_add_video" InputGestureText="Ctrl+I" Click="AddVideoImage_Click"/>
                <MenuItem x:Name="mnuAddAudio" Tag="mnu_add_audio" InputGestureText="Ctrl+Shift+I" Click="AddAudioOnly_Click"/>
                <MenuItem x:Name="mnuImportYouTube"
                          Header="▶ Import from YouTube"
                          InputGestureText="Ctrl+Y"
                          Click="ImportFromYouTube_Click"
                          AutomationProperties.Name="Import video or audio from YouTube directly to timeline"/>
                <Separator/>
                <MenuItem x:Name="mnuAddVideoTrack" Tag="add_video_track" Click="AddVideoTrack_Click"/>
                <MenuItem x:Name="mnuAddAudioTrack" Tag="add_audio_track" Click="AddAudioTrack_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuMoveLeft" Tag="move_left" InputGestureText="Ctrl+Left" Click="MoveLeft_Click"/>
                <MenuItem x:Name="mnuMoveRight" Tag="move_right" InputGestureText="Ctrl+Right" Click="MoveRight_Click"/>
                <MenuItem x:Name="mnuMoveUp" Tag="mnu_move_up" InputGestureText="Ctrl+Up" Click="MoveClipUp_Click"/>
                <MenuItem x:Name="mnuMoveDown" Tag="mnu_move_down" InputGestureText="Ctrl+Down" Click="MoveClipDown_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuSetDuration" Tag="mnu_set_duration" InputGestureText="Ctrl+D" Click="SetClipDuration_Click"/>
                <MenuItem x:Name="mnuSetVolume" Tag="menu_set_volume" InputGestureText="Ctrl+Alt+V" Click="SetClipVolume_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuAddMarker" Tag="marker" InputGestureText="Ctrl+M" Click="AddMarker_Click"/>
                <MenuItem x:Name="mnuNextMarker" Tag="mw_next_marker" InputGestureText="Ctrl+Shift+N" Click="NextMarker_Click"/>
                <MenuItem x:Name="mnuPrevMarker" Tag="mnu_prev_marker" InputGestureText="Ctrl+Shift+P" Click="PrevMarker_Click"/>
                <MenuItem x:Name="mnuClearMarkers" Tag="mw_clear_markers" Click="ClearAllMarkers_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuAI" Tag="mw_ai_menu">
                <MenuItem x:Name="mnuVideoEngine" Tag="🎬|mnu_video_engine" Click="OpenVideoEngine_Click" FontWeight="Bold"/>
                <MenuItem x:Name="mnuVideoReview" Tag="🔍|mnu_video_review" Click="OpenVideoReview_Click" FontWeight="Bold"
                          Header="🔍 AI Video Review"
                          AutomationProperties.Name="Open AI Video Review — Qwen2-VL analyzes the finished video"/>
                <MenuItem x:Name="mnuClipDescriptions" Tag="👁|mnu_clip_desc" Click="DescribeAllClips_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuGenerateVoice" Tag="mw_generate_voice" Click="GenerateVoice_Click"/>
                <MenuItem x:Name="mnuGenerateFrames" Tag="mw_generate_frames" Click="GenerateAI_Click"/>
                <MenuItem x:Name="mnuTranscribe" Tag="mnu_transcribe" Click="TranscribeAudio_Click"/>
                <MenuItem x:Name="mnuSyncLyrics" Tag="mnu_sync_lyrics" Click="SyncLyrics_Click"/>
                <MenuItem x:Name="mnuAddSyncSubs" Tag="mnu_add_sync_subs" Click="AddSyncedSubtitles_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuHighlightEngine"
                          Header="🎬 AI Highlight Engine"
                          InputGestureText="Ctrl+Shift+H"
                          Click="OpenHighlightEngine_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Open AI Highlight Engine — automatically extracts the most interesting moments and syncs cuts to beat"/>
                <MenuItem x:Name="mnuPhase3"
                          Header="🚀 AI Suite Phase 3"
                          InputGestureText="Ctrl+Shift+3"
                          Click="OpenPhase3_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Open Phase 3 — Transitions, Audio Mix, Accessibility and Multi-format Export"/>
                <Separator/>
                <MenuItem x:Name="mnuSceneDetection"
                          Header="🔍 Smart Scene Detection"
                          InputGestureText="Ctrl+Shift+D"
                          Click="OpenSceneDetection_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Open Smart Scene Detection — automatic scene detection from video"/>
                <MenuItem x:Name="mnuTimelineAI"
                          Header="🤖 Timeline AI Asistent"
                          InputGestureText="Ctrl+Shift+T"
                          Click="OpenTimelineAI_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Open Timeline AI Assistant — AI commands on the timeline"/>
                <MenuItem x:Name="mnuColorGrading"
                          Header="🎨 Color Grading Engine"
                          InputGestureText="Ctrl+Shift+G"
                          Click="OpenColorGrading_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Open Color Grading Engine — AI automatically color grades by clip content"/>
                <Separator/>
                <MenuItem x:Name="mnuBatchExport"
                          Header="📦 Batch Export"
                          InputGestureText="Ctrl+Shift+B"
                          Click="OpenBatchExport_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Batch Export — render multiple projects at once"/>
                <MenuItem x:Name="mnuProjectTemplates"
                          Header="📋 Project Templates"
                          InputGestureText="Ctrl+Shift+P"
                          Click="OpenProjectTemplates_Click"
                          FontWeight="Bold"
                          AutomationProperties.Name="Project Templates — save and load project settings"/>
            </MenuItem>
            <MenuItem x:Name="mnuEffects" Tag="mnu_effects_menu">
                <MenuItem x:Name="mnuVideoEffects" Tag="mnu_video_effects" Click="ShowVideoEffectsTab_Click"/>
                <MenuItem x:Name="mnuAudioEffects" Tag="mnu_audio_effects" Click="ShowAudioEffectsTab_Click"/>
                <MenuItem x:Name="mnuTransitions" Tag="mnu_transitions" Click="ShowTransitionsTab_Click"/>
                <MenuItem x:Name="mnuAnimations" Tag="mnu_animations" Click="ShowAnimationTab_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuApplyEffects" Tag="mnu_apply_effects" InputGestureText="Ctrl+Shift+E" Click="ApplyEffects_Click"/>
                <MenuItem x:Name="mnuResetEffects" Tag="mnu_reset_effects" Click="ResetEffects_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuTools" Tag="mnu_tools_menu">
                <MenuItem x:Name="mnuSubtitles" Tag="mnu_subtitles" Click="ShowSubtitlesTab_Click"/>
                <MenuItem x:Name="mnuMarkers" Tag="mnu_markers" Click="ShowMarkersDialog_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuGPU" Tag="gpu_acceleration" IsCheckable="True" IsChecked="True" Click="ToggleGPUAcceleration_Click"/>
                <MenuItem x:Name="mnuMediaProviders"
                          Header="🌐 Media Providers (API keys)"
                          Click="MnuMediaProviders_Click"
                          InputGestureText="Ctrl+M"
                          AutomationProperties.Name="Media provider settings — Pixabay, Pexels, Coverr"/>
                <Separator/>
                <MenuItem x:Name="mnuSettings" Tag="mw_settings" Click="ShowPreferences_Click"/>
            </MenuItem>
            <MenuItem x:Name="mnuHelp" Tag="mw_help_menu">
                <MenuItem x:Name="mnuShortcuts" Tag="mnu_shortcuts" InputGestureText="F1" Click="ShowHelp_Click"/>
                <MenuItem x:Name="mnuManual" Tag="mw_manual" Click="ShowUserManual_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuUpdates" Tag="mw_updates" Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem x:Name="mnuAbout" Tag="mw_about" Click="ShowAbout_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" Margin="0,0,0,10" Background="{DynamicResource PanelBg}">
            <Button x:Name="btnNew" Tag="📄|new_project|Ctrl+N" Click="NewProject_Click"/>
            <Button x:Name="btnOpen" Tag="📂|open_project|Ctrl+O" Click="LoadProject_Click"/>
            <Button x:Name="btnSave" Tag="💾|save_project|Ctrl+S" Click="SaveProject_Click"/>
            <Button x:Name="btnPixabay" Content="🔍 PIXABAY" Click="btnPixabay_Click"
        Tag="tooltip:mw_toolbar_pixabay_tip"
        Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
            <Button x:Name="btnAIVideoCreator" Content="🤖 AI VIDEO" Click="btnAIVideoCreator_Click"
        Tag="tooltip:mnu_ai_video_creator_tip"
        Background="#9C27B0" Foreground="{DynamicResource ButtonTextBrush}"/>
            <Button x:Name="btnVideoReview" Content="🔍 AI REVIEW" Click="OpenVideoReview_Click"
        Background="#1565C0" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold"
        ToolTip="AI Video Review — Qwen2-VL analyzes the finished video"
        AutomationProperties.Name="Open AI Video Review"/>
            <Separator/>
            <Button x:Name="btnUndoTool" Tag="↩|undo|Ctrl+Z" Click="Undo_Click"/>
            <Button x:Name="btnRedoTool" Tag="↪|mnu_redo|Ctrl+Y" Click="Redo_Click"/>
            <Separator/>
            <Button x:Name="btnCutTool" Tag="✂|cut|Ctrl+X" Click="CutClip_Click"/>
            <Button x:Name="btnCopyTool" Tag="📋|copy|Ctrl+C" Click="CopyClip_Click"/>
            <Button x:Name="btnPasteTool" Tag="📌|paste|Ctrl+V" Click="PasteClip_Click"/>
            <Separator/>
            <Button x:Name="btnDeleteTool" Tag="🗑|delete|Del" Click="RemoveFromTimeline_Click"/>
            <Separator/>
            <Button x:Name="btnAccessibilityTool" Tag="♿|accessibility|Ctrl+Shift+A" Click="ToggleAccessibilityMode_Click"/>
            <Button x:Name="btnLogTool" Tag="📋|mnu_log_window|Ctrl+Shift+L" Click="ShowLogWindow_Click"/>
            <Separator/>
            <Button x:Name="btnRenderTool" Tag="🎬|render|Ctrl+R" Click="FinalRender_Click" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
            <Button x:Name="btnAutoArrange" Tag="🎬|mnu_auto_arrange" Click="btnAutoArrange_Click"
        Background="#FF6F00" Foreground="{DynamicResource ButtonTextBrush}"/>
        </ToolBar>

        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="5" Margin="0,0,0,10" 
                x:Name="borderAccessibilityStatus" Visibility="Collapsed">
            <TextBlock x:Name="txtAccessibilityStatus" Foreground="{DynamicResource AccentBrush}" 
                       Text="♿ ACCESSIBILITY MODE ON"
                       Padding="10" FontWeight="Bold" TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="3" Background="Black" Height="200" CornerRadius="5" 
                BorderBrush="#444" BorderThickness="1" Margin="0,0,0,10">
            <vlc:VideoView x:Name="vlcVideoView"/>
        </Border>

        <TabControl Grid.Row="3" Margin="0,210,0,0" Background="#121212" BorderBrush="#333">

            <TabItem x:Name="tabTimeline" Header="📋 TIMELINE">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="btnMoveLeft" Tag="⬅|move_left|Ctrl+Left" Click="MoveLeft_Click" Width="150" Height="32" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        <Button x:Name="btnMoveRight" Tag="➡|move_right|Ctrl+Right" Click="MoveRight_Click" Width="160" Height="32" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Button x:Name="btnCut" Tag="✂|cut|Ctrl+X" Click="CutClip_Click" Width="120" Height="32" Background="#FF6F00" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Button x:Name="btnCutAllMarkers" Tag="✂✂|cut_all_markers|Ctrl+Shift+X" Click="CutAtAllMarkers_Click" Width="180" Height="32" Background="#FF6F00" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Button x:Name="btnDuration" Tag="⏱|duration|Ctrl+D" Click="SetClipDuration_Click" Width="130" Height="32" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Button x:Name="btnVolume" Tag="🔊|volume" Click="SetClipVolume_Click" Width="120" Height="32" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Separator Width="15" Background="{DynamicResource ControlBg}" Margin="5,0"/>
                        <Button x:Name="btnZoomIn" Tag="🔍|zoom_in|Ctrl++" Click="ZoomIn_Click" Width="120" Height="32" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        <Button x:Name="btnZoomOut" Tag="🔍|zoom_out|Ctrl+-" Click="ZoomOut_Click" Width="100" Height="32" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <TextBlock x:Name="txtZoomStatus" Text="Zoom: 1.0x" Foreground="Yellow" VerticalAlignment="Center" Margin="10,0" FontSize="11"/>
                        <Separator Width="15" Background="{DynamicResource ControlBg}" Margin="5,0"/>
                        <Button x:Name="btnAddMarker" Tag="📍|marker|Ctrl+M" Click="AddMarker_Click" Width="130" Height="32" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        <Button x:Name="btnNextMarker" Tag="⏩|next_marker|Ctrl+Shift+N" Click="NextMarker_Click" Width="140" Height="32" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0"/>
                        <Button x:Name="btnPrevMarker" Tag="⏪|prev_marker|Ctrl+Shift+P" Click="PrevMarker_Click" Width="140" Height="32" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="txtTrackSelector" Tag="mnu_show_track" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbTrackSelector" Width="120" Height="25" SelectionChanged="TrackSelector_Changed" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Show track">
                            <ComboBoxItem Content="🎬 Video 1" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="🎬 Video 2" Tag="1"/>
                            <ComboBoxItem Content="🎵 Audio 1" Tag="2"/>
                            <ComboBoxItem Content="🎵 Audio 2" Tag="3"/>
                            <ComboBoxItem Content="📋 All tracks" Tag="-1"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                        <wfhost:WindowsFormsHost x:Name="wfhTimeline" Margin="2">
                            <wf:ListView x:Name="timelineListView" 
                                         View="Details"
                                         FullRowSelect="True"
                                         GridLines="False"
                                         HideSelection="False"
                                         MultiSelect="True"
                                         AutoArrange="True"
                                         BackColor="#1E1E1E"
                                         ForeColor="White"
                                         Font="Segoe UI, 10pt">
                                <wf:ListView.Columns>
                                    <wf:ColumnHeader Text="#" Width="50" TextAlign="Center"/>
                                    <wf:ColumnHeader Text="Clip name" Width="350"/>
                                    <wf:ColumnHeader Text="Type" Width="60"/>
                                    <wf:ColumnHeader Text="Duration" Width="80" TextAlign="Center"/>
                                    <wf:ColumnHeader Text="Start" Width="80" TextAlign="Center"/>
                                    <wf:ColumnHeader Text="End" Width="80" TextAlign="Center"/>
                                    <wf:ColumnHeader Text="Audio description" Width="300"/>
                                </wf:ListView.Columns>
                            </wf:ListView>
                        </wfhost:WindowsFormsHost>
                    </Border>

                    <TextBlock x:Name="txtTimelineInfo" Grid.Row="3" Foreground="{DynamicResource AccentBrush}" Text="Total clips: 0 | Total duration: 0:00 | Zoom: 1.0x" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabAI" Header="🤖 AI FEATURES">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="txtAIVoice" Text="🗣 AI VOICE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="txtVoiceTextLabel" Text="Text to speak:" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <TextBox x:Name="txtVoiceText" Height="60" TextWrapping="Wrap" Padding="10" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True" AutomationProperties.Name="Text to speak"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <RadioButton x:Name="rbSrb" Content="Serbian" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="rbEng" Content="English" IsChecked="True" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button x:Name="btnGenerateVoice" Content="🗣 GENERATE VOICE" Click="GenerateVoice_Click" Height="40" Background="#00E676" FontWeight="Bold" Margin="0,10"/>
                                <ProgressBar x:Name="prgVoice" Height="6" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtVoiceStatus" Foreground="Yellow"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="txtAIFrames" Text="🎨 AI FRAMES" FontSize="16" FontWeight="Bold" Foreground="#AA00FF"/>
                                <TextBlock x:Name="txtAIPromptLabel" Text="Image description (comma-separated):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <TextBox x:Name="txtAIPrompt" Height="60" TextWrapping="Wrap" Padding="10" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True" Width="400" AutomationProperties.Name="Image description input field" AutomationProperties.HelpText="Enter an image description separated by commas. Use Ctrl+V to paste."/>
                                <Button x:Name="btnPastePrompt" Content="📋 Paste" Click="PastePrompt_Click" Width="80" Height="35" Margin="10,0,0,0" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" AutomationProperties.Name="Paste prompt from clipboard" AutomationProperties.HelpText="Click to paste text from the clipboard into the description field"/>
                                <Button x:Name="btnGenerate" Content="🎨 GENERATE AI FRAMES" Click="GenerateAI_Click" Height="40" Margin="0,10" Background="#AA00FF" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" AutomationProperties.Name="Generate AI frames" AutomationProperties.HelpText="Click to generate images based on the entered description"/>
                                <Button x:Name="btnPollinations" Content="🌸 POLLINATIONS.AI (free, no API)" Click="GenerateWithPollinations_Click" Height="40" Margin="0,0,0,10" Background="#006064" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" AutomationProperties.Name="Generate images using Pollinations.ai, free, no API key" AutomationProperties.HelpText="Alternative for image generation. No API key required."/>
                                <Button x:Name="btnSkiaAnimation" Content="✨ SKIA TEXT ANIMATION" Click="GenerateSkiaAnimation_Click" Height="40" Margin="0,0,0,10" Background="#1A237E" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" AutomationProperties.Name="Create a text animation using SkiaSharp. Choose text, style, colors and duration." AutomationProperties.HelpText="Creates an animated video clip with your text. FadeIn, SlideLeft, Bounce, Stars, Rainbow and other styles."/>
                                <ProgressBar x:Name="prgAI" Height="6" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtAIStatus" Foreground="Yellow"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="txtAITranscribe" Text="🎤 AI TRANSCRIPTION" FontSize="16" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock x:Name="txtTranscribeLabel" Text="Audio file to transcribe:" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="cmbTranscribeAudio" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="TranscribeAudio_Selected" AutomationProperties.Name="Audio file to transcribe"/>
                                <Button x:Name="btnTranscribe" Content="🎤 TRANSCRIBE" Click="TranscribeAudio_Click" Height="40" Background="#00BCD4" FontWeight="Bold" Margin="0,10"/>
                                <TextBox x:Name="txtTranscriptionResult" Height="100" TextWrapping="Wrap" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" IsReadOnly="True" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Transcription result"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock x:Name="txtAILyrics" Text="🎤 AI LYRICS SYNC" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock x:Name="txtLyricsLabel" Text="Song lyrics (one line per row):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <TextBox x:Name="txtLyrics" Height="80" TextWrapping="Wrap" Padding="10" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True" AutomationProperties.Name="Song lyrics, one line per row"/>
                                <TextBlock x:Name="txtSelectAudioLabel" Text="Select audio clip:" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="cmbAudioClips" Height="30" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="AudioClip_Selected" AutomationProperties.Name="Select audio clip"/>
                                <Button x:Name="btnSyncLyrics" Content="🎤 SYNC LYRICS" Click="SyncLyrics_Click" Height="40" Background="{DynamicResource WarningBrush}" FontWeight="Bold" Margin="0,10"/>
                                <ProgressBar x:Name="prgSync" Height="6" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtSyncStatus" Foreground="Yellow"/>
                                <ListBox x:Name="lstAutoSubtitles" Height="80" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,10"/>
                                <Button x:Name="btnAddSyncedSubtitles" Content="➕ ADD SUBTITLES" Click="AddSyncedSubtitles_Click" Height="35" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="tabEffects" Header="🎨 EFFECTS">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock x:Name="txtVideoEffects" Text="🎬 VIDEO EFFECTS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="txtBrightness" Text="Brightness:" Foreground="{DynamicResource TextPrimary}"/>
                        <Slider x:Name="sldBrightness" Minimum="-100" Maximum="100" Value="0" Margin="0,5,0,15" AutomationProperties.Name="Brightness"/>
                        <TextBlock x:Name="txtContrast" Text="Contrast:" Foreground="{DynamicResource TextPrimary}"/>
                        <Slider x:Name="sldContrast" Minimum="-100" Maximum="100" Value="0" Margin="0,5,0,15" AutomationProperties.Name="Contrast"/>
                        <TextBlock x:Name="txtBlur" Text="Blur:" Foreground="{DynamicResource TextPrimary}"/>
                        <Slider x:Name="sldBlur" Minimum="0" Maximum="20" Value="0" Margin="0,5,0,15" AutomationProperties.Name="Blur"/>
                        <Separator Margin="0,20"/>
                        <TextBlock x:Name="txtAudioEffects" Text="🎵 AUDIO EFFECTS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="txtBass" Text="Bass boost:" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldBass" Minimum="0" Maximum="20" Value="0" Width="200" ValueChanged="AudioEffect_ValueChanged" AutomationProperties.Name="Bass boost"/>
                            <Button x:Name="btnPreviewBass" Content="👂 PREVIEW" Click="PreviewBass_Click" Width="100" Height="25" Margin="10,0" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtTreble" Text="Treble boost:" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldTreble" Minimum="0" Maximum="20" Value="0" Width="200" ValueChanged="AudioEffect_ValueChanged" AutomationProperties.Name="Treble boost"/>
                            <Button x:Name="btnPreviewTreble" Content="👂 PREVIEW" Click="PreviewTreble_Click" Width="100" Height="25" Margin="10,0" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="chkGPUAcceleration" Content="🎮 GPU acceleration" Foreground="{DynamicResource TextPrimary}" Margin="0,15" IsChecked="True" Checked="GPUAcceleration_Checked" Unchecked="GPUAcceleration_Checked"/>
                        <CheckBox x:Name="chkEnableSubtitles" Content="📝 Subtitles in video" Foreground="{DynamicResource TextPrimary}" Margin="0,5" IsChecked="True" ToolTip="Enable/disable subtitle display in the final render. Disable for a clean video without text."/>
                        <TextBlock x:Name="txtReverb" Text="Reverb:" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldReverb" Minimum="0" Maximum="100" Value="0" Width="200" ValueChanged="AudioEffect_ValueChanged" AutomationProperties.Name="Reverb"/>
                            <Button x:Name="btnPreviewReverb" Content="👂 PREVIEW" Click="PreviewReverb_Click" Width="100" Height="25" Margin="10,0" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtPreviewDuration" Text="Preview duration (seconds):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldPreviewDuration" Minimum="3" Maximum="30" Value="10" Width="200" TickFrequency="1" TickPlacement="BottomRight" AutomationProperties.Name="Preview duration in seconds"/>
                            <TextBlock x:Name="txtPreviewDurationValue" Text="10 s" Foreground="Yellow" Margin="10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="chkCompressor" Content="Compressor" Foreground="{DynamicResource TextPrimary}" Margin="0,15" Checked="AudioEffect_ValueChanged" Unchecked="AudioEffect_ValueChanged"/>
                        <Button x:Name="btnApplyEffects" Content="💾 APPLY EFFECTS" Click="ApplyEffects_Click" Height="45" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,20"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="tabSubtitles" Header="📝 SUBTITLES">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="txtSubtitleTextLabel" Text="Subtitle text:" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox x:Name="txtSubtitleText" Height="60" TextWrapping="Wrap" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,10" AutomationProperties.Name="Subtitle text"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtSubStartLabel" Text="Start (s): " Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSubStart" Width="80" Text="0" Margin="0,0,20,0" AutomationProperties.Name="Start time in seconds"/>
                            <TextBlock x:Name="txtSubEndLabel" Text="End (s): " Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSubEnd" Width="80" Text="5" Margin="0,0,20,0" AutomationProperties.Name="End time in seconds"/>
                            <Button x:Name="btnAddSubtitle" Content="➕ ADD SUBTITLE" Click="AddSubtitle_Click" Width="120" Height="35" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="lstSubtitles" Grid.Row="1" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}"/>
                    <Button x:Name="btnClearSubtitles" Content="🗑 CLEAR ALL SUBTITLES" Click="ClearSubtitles_Click" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}" Height="40" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabTransitions" Header="🎬 TRANSITIONS">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtTransitionsInfo" Text="Drag an effect between two clips on the timeline" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" TextAlignment="Center"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="txtTransitionDuration" Text="Effect duration (s):" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Slider x:Name="sldTransitionDuration" Minimum="0.5" Maximum="5" Value="1" Width="150" Margin="10,0" TickFrequency="0.5" TickPlacement="BottomRight" ValueChanged="sldTransitionDuration_ValueChanged" AutomationProperties.Name="Transition duration in seconds"/>
                        <TextBlock x:Name="txtTransitionDurationValue" Text="1.0 s" Foreground="Yellow" Margin="10,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="lstTransitions" Grid.Row="2" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="Transition_Selected" Margin="0,0,0,10">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add between selected two clips" Click="AddTransitionBetweenSelected_Click"/>
                                <MenuItem Header="Add between specific clips..." Click="AddTransitionBetweenSpecific_Click"/>
                                <Separator/>
                                <MenuItem Header="Remove transition" Click="RemoveTransition_Click"/>
                                <Separator/>
                                <MenuItem Header="Set duration" Click="SetTransitionDuration_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="{Binding Icon}" FontSize="20" Width="40"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text=" (drag)" FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="btnRemoveTransition" Content="🗑 REMOVE TRANSITION" Click="RemoveTransition_Click" Grid.Row="3" Height="35" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabAnimation" Header="🎬 ANIMATIONS">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtAnimInfo" Text="Keyframe animation for the selected clip" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" TextAlignment="Center"/>
                    <TextBlock Grid.Row="1" x:Name="txtSelectedClip" Text="Selected clip: none" Foreground="Yellow" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="txtKeyframeList" Text="Keyframes:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ListBox x:Name="lstKeyframes" Width="200" Height="100" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" SelectionChanged="Keyframe_Selected" Margin="0,0,10,0">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Tag="mnu_add_keyframe" Click="AddKeyframe_Click" InputGestureText="Ctrl+K"/>
                                    <MenuItem Tag="mnu_remove_keyframe" Click="RemoveKeyframe_Click" InputGestureText="Ctrl+Shift+K"/>
                                    <MenuItem Header="Apply to keyframe" Click="ApplyKeyframe_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Set zoom" Click="SetZoomKeyframe_Click"/>
                                    <MenuItem Header="Set rotation" Click="SetRotationKeyframe_Click"/>
                                    <MenuItem Header="Set position" Click="SetPositionKeyframe_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="3">
                                        <TextBlock Text="📍" FontSize="14" Width="25"/>
                                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource AccentBrush}" Width="50"/>
                                        <TextBlock Text=" zoom:" Foreground="Gray" FontSize="10"/>
                                        <TextBlock Text="{Binding Zoom}" Foreground="Yellow" Width="35"/>
                                        <TextBlock Text=" rot:" Foreground="Gray" FontSize="10"/>
                                        <TextBlock Text="{Binding Rotation}" Foreground="Yellow" Width="35"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="btnAddKeyframe" Content="➕ ADD" Click="AddKeyframe_Click" Width="80" Height="30" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
                        <Button x:Name="btnRemoveKeyframe" Content="🗑 REMOVE" Click="RemoveKeyframe_Click" Width="80" Height="30" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource ControlBg}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🤖 AI ANIMATION GUIDE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                            <TextBlock Tag="enter_animation_desc" Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,5"/>
                            <TextBox x:Name="txtAnimationPrompt" Height="60" TextWrapping="Wrap" Padding="10" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True" AutomationProperties.Name="Animation description field" AutomationProperties.HelpText="Describe the animation you want to create"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <Button x:Name="btnGenerateScenario" Content="🔮 Generate scenario" Click="GenerateScenario_Click" Width="150" Height="35" Background="{DynamicResource PurpleBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,10,0"/>
                                <Button x:Name="btnAISuggestLayout" Content="🎲 AI suggest layout" Click="AISuggestLayout_Click" Width="180" Height="35" Background="#AA00FF" Foreground="{DynamicResource ButtonTextBrush}"/>
                            </StackPanel>
                            <TextBlock Tag="anim_scenario_label" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                            <ListBox x:Name="lstAnimationScenes" Height="150" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="List of animation scenes">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Tag="anim_image_label" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Width="50"/>
                                                    <ComboBox ItemsSource="{Binding AvailableImages}" SelectedItem="{Binding ImageName}" Width="120" AutomationProperties.Name="Image selection"/>
                                                    <TextBlock Tag="duration" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Width="70" Margin="10,0"/>
                                                    <TextBox Text="{Binding Duration}" Width="50" AutomationProperties.Name="Duration in seconds"/>
                                                    <TextBlock Tag="anim_effect_label" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Width="50" Margin="10,0"/>
                                                    <ComboBox ItemsSource="{Binding AvailableEffects}" SelectedItem="{Binding Effect}" Width="100" AutomationProperties.Name="Izbor efekta"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <Button x:Name="btnAddScene" Content="➕ Add scene" Click="AddScene_Click" Width="100" Margin="0,0,5,0"/>
                                <Button x:Name="btnRemoveScene" Content="🗑 Delete scene" Click="RemoveScene_Click" Width="100" Margin="5,0"/>
                                <Button x:Name="btnMoveSceneUp" Content="🔼 Up" Click="MoveSceneUp_Click" Width="80" Margin="5,0"/>
                                <Button x:Name="btnMoveSceneDown" Content="🔽 Down" Click="MoveSceneDown_Click" Width="80" Margin="5,0"/>
                            </StackPanel>
                            <TextBlock Tag="dlg_pos_manual" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Tag="dlg_pos_start" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtAnimationStartTime" Width="60" Text="0" Margin="5,0" AutomationProperties.Name="Animation start position in seconds"/>
                                <Button x:Name="btnSetAnimationPosition" Content="📍 SET ANIMATION POSITION" Click="SetAnimationPosition_Click" Width="220" Height="35" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Background="{DynamicResource ControlBg}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="txtAnimZoom" Text="Zoom (0.5 - 3.0):" Foreground="{DynamicResource TextPrimary}"/>
                            <Slider x:Name="sldZoom" Minimum="0.5" Maximum="3.0" Value="1.0" Width="200" TickFrequency="0.1" TickPlacement="BottomRight" ValueChanged="AnimValue_Changed" AutomationProperties.Name="Zoom level"/>
                            <TextBlock x:Name="txtZoomValue" Text="1.00" Foreground="Yellow" Margin="10,0"/>
                            <TextBlock x:Name="txtAnimRotation" Text="Rotation (degrees):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                            <Slider x:Name="sldRotation" Minimum="-360" Maximum="360" Value="0" Width="200" TickFrequency="10" TickPlacement="BottomRight" ValueChanged="AnimValue_Changed" AutomationProperties.Name="Rotation in degrees"/>
                            <TextBlock x:Name="txtRotationValue" Text="0°" Foreground="Yellow" Margin="10,0"/>
                            <TextBlock x:Name="txtAnimX" Text="X offset (px):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                            <Slider x:Name="sldX" Minimum="-500" Maximum="500" Value="0" Width="200" TickFrequency="10" TickPlacement="BottomRight" ValueChanged="AnimValue_Changed" AutomationProperties.Name="Horizontal offset in pixels"/>
                            <TextBlock x:Name="txtXValue" Text="0" Foreground="Yellow" Margin="10,0"/>
                            <TextBlock x:Name="txtAnimY" Text="Y offset (px):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                            <Slider x:Name="sldY" Minimum="-500" Maximum="500" Value="0" Width="200" TickFrequency="10" TickPlacement="BottomRight" ValueChanged="AnimValue_Changed" AutomationProperties.Name="Vertical offset in pixels"/>
                            <TextBlock x:Name="txtYValue" Text="0" Foreground="Yellow" Margin="10,0"/>
                            <TextBlock x:Name="txtAnimOpacity" Text="Opacity (0-1):" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,0"/>
                            <Slider x:Name="sldOpacity" Minimum="0" Maximum="1" Value="1" Width="200" TickFrequency="0.05" TickPlacement="BottomRight" ValueChanged="AnimValue_Changed" AutomationProperties.Name="Opacity from 0 to 1"/>
                            <TextBlock x:Name="txtOpacityValue" Text="1.00" Foreground="Yellow" Margin="10,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button x:Name="btnApplyKeyframe" Content="💾 APPLY KEYFRAME" Click="ApplyKeyframe_Click" Width="150" Height="35" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,10,0"/>
                        <Button x:Name="btnPreviewAnimation" Content="👁️ PREVIEW" Click="PreviewAnimation_Click" Width="120" Height="35" Background="#00BCD4" Foreground="{DynamicResource ButtonTextBrush}"/>
                        <Button x:Name="btnCreateAnimationFromScenes" Content="🎬 CREATE ANIMATION" Click="CreateAnimationFromScenes_Click" Width="180" Height="35" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="6" x:Name="txtAnimHelp" Tag="anim_help_note" Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnSeekBack" Tag="⏪|seek_back" Click="SeekBack_Click" Width="70" Height="35" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"/>
            <Button x:Name="btnPlay" Tag="▶|play" Click="TogglePlay_Click" Width="90" Height="35" Margin="5,0" Background="#1A237E" Foreground="{DynamicResource ButtonTextBrush}"/>
            <Button x:Name="btnSeekForward" Tag="⏩|seek_forward" Click="SeekForward_Click" Width="70" Height="35" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="txtCurrentPosition" Foreground="Yellow" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12"/>
            <TextBlock x:Name="txtMarkerStatus" Foreground="{DynamicResource WarningBrush}" Text="" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- ════════════════════════════════════════════════════════════════
             STATUS BAR — always visible, JAWS/NVDA reads automatically (Assertive)
             Korisnik NIKAD ne treba otvarati Ctrl+Shift+L da bi dobio info.
             ════════════════════════════════════════════════════════════════ -->
        <Border x:Name="statusBarBorder" Grid.Row="4" Background="#111111" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0"
                VerticalAlignment="Bottom" Margin="0,0,0,0" Padding="6,3,6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Glavna statusna poruka — JAWS cita svaku promjenu odmah (Assertive) -->
                <TextBox x:Name="txtJawsLog"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#00FF00"
                         Text="System ready..."
                         TextWrapping="Wrap"
                         FontSize="11"
                         VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Assertive"
                         AutomationProperties.Name="Status message"
                         ToolTip="Status messages. JAWS reads automatically. Ctrl+Shift+L for detailed log."/>
                <!-- Desni info: pozicija / trajanje -->
                <TextBlock x:Name="txtStatus"
                           Grid.Column="1"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="Status: Idle"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0,0,0"
                           FontSize="10"/>
            </Grid>
        </Border>
        <!-- Nevidljiv element koji drzi JAWS ghost za duple poruke — zadrzano radi kompatibilnosti -->
        <TextBox x:Name="txtJawsGhost" Grid.Row="4" Height="1" Width="1" Opacity="0" IsReadOnly="True"
                 Background="Transparent" BorderThickness="0" IsTabStop="False"
                 AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name=""/>

        <ProgressBar x:Name="prgRender" Grid.Row="4" Height="8" VerticalAlignment="Bottom" Margin="0,0,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="txtRenderStatus" Grid.Row="4" Foreground="Yellow" TextAlignment="Center" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Render status"/>

        <!-- txtStatus preseljen unutar statusBarBorder -->
    </Grid>
</Window>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BgDark">#1E1E2E</Color>
    <Color x:Key="BgMid">#2A2A3E</Color>
    <Color x:Key="BgLight">#313145</Color>
    <Color x:Key="BgPanel">#252535</Color>
    <Color x:Key="Accent">#7C6AF7</Color>
    <Color x:Key="AccentHover">#9D8FFF</Color>
    <Color x:Key="AccentAI">#1D9E75</Color>
    <Color x:Key="TextPrimary">#E8E8F0</Color>
    <Color x:Key="TextSecondary">#A0A0B8</Color>
    <Color x:Key="TextMuted">#606078</Color>
    <Color x:Key="Border">#3A3A52</Color>
    <Color x:Key="Danger">#E24B4A</Color>
    <Color x:Key="Warning">#BA7517</Color>
    <Color x:Key="Success">#1D9E75</Color>
    <Color x:Key="TrackBlue">#378ADD</Color>
    <Color x:Key="TrackGreen">#1D9E75</Color>
    <Color x:Key="TrackOrange">#D85A30</Color>
    <Color x:Key="TrackPink">#D4537E</Color>
    <Color x:Key="TrackPurple">#7F77DD</Color>

    <SolidColorBrush x:Key="BrBgDark" Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BrBgMid" Color="{StaticResource BgMid}"/>
    <SolidColorBrush x:Key="BrBgLight" Color="{StaticResource BgLight}"/>
    <SolidColorBrush x:Key="BrBgPanel" Color="{StaticResource BgPanel}"/>
    <SolidColorBrush x:Key="BrAccent" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="BrAccentHover" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="BrAccentAI" Color="{StaticResource AccentAI}"/>
    <SolidColorBrush x:Key="BrText" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrTextSec" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrTextMuted" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BrBorder" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BrDanger" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="BrWarning" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="BrSuccess" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="BrTransparent" Color="Transparent"/>

    <!-- Button Style -->
    <Style x:Key="StdButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrBgLight}"/>
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrBgMid}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrAccentHover}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AI Button Style -->
    <Style x:Key="AIButton" TargetType="Button" BasedOn="{StaticResource StdButton}">
        <Setter Property="Background" Value="#1A3D30"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrAccentAI}"/>
        <Setter Property="Foreground" Value="#4ECFA0"/>
    </Style>

    <!-- Transport Button (big round) -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrBgLight}"/>
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrAccentHover}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider Style -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
        <Setter Property="Background" Value="{StaticResource BrBgMid}"/>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrBgMid}"/>
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrText}"/>
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrBgMid}"/>
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Label Style -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- MenuItem Style — pokriva i vrh menija i podmenije (dropdown-ove).
         Bez ovoga, WPF podrazumevano crta pozadinu podmenija belom bez
         obzira na Menu.Background, dok tekst nasleđuje svetlu boju iz teme
         — rezultat je bezbojan/nevidljiv tekst na beloj pozadini kad god se
         otvori bilo koji meni (File/Edit/Layers/itd). Ovo je bio glavni
         uzrok "sve je belo, ne mogu da kliknem" prijave. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               ContentSource="Header" RecognizesAccessKey="True"/>
                            <TextBlock x:Name="Gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Margin="16,0,10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrTextMuted}" FontSize="11"/>
                            <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L0,8 L4,4 Z"
                                  Fill="{StaticResource BrTextSec}" Margin="4,0,8,0"
                                  VerticalAlignment="Center" Visibility="Collapsed"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource BrBgPanel}" BorderBrush="{StaticResource BrBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="2">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Orientation="Vertical"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Popup" Property="Placement" Value="Bottom"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Popup" Property="Placement" Value="Right"/>
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BrBgMid}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator (linije u menijima) -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BrBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border BorderBrush="{StaticResource BrBorder}" BorderThickness="0,1,0,0" Margin="6,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb za scrollbar -->
    <Style x:Key="UltraScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource BrBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollBar slim, tamna tema (ranije je bila stilizovana samo pozadina
         trake, dok su dugmici/klizač ostajali na svetloj/sistemskoj temi) -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource BrBgDark}"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource UltraScrollThumb}" Margin="2,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

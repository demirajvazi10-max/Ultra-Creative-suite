                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="RemoveCustomRhythmMelodicHitButton" Content="Ukloni izabrano" Click="RemoveCustomRhythmMelodicHitButton_Click" />
                    <Button x:Name="ClearCustomRhythmMelodicHitsButton" Content="Obriši sve" Margin="8,0,0,0" Click="ClearCustomRhythmMelodicHitsButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AddCustomRhythmBarButton" Content="Dodaj kao novi takt" Click="AddCustomRhythmBarButton_Click" />
                    <Button x:Name="RemoveLastCustomRhythmBarButton" Content="Ukloni poslednji takt" Margin="8,0,0,0" Click="RemoveLastCustomRhythmBarButton_Click" />
                    <Button x:Name="ClearCustomRhythmBarsButton" Content="Obriši sve taktove" Margin="8,0,0,0" Click="ClearCustomRhythmBarsButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CustomRhythmBarsStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Ovaj ritam još nema nijedan takt." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="CustomRhythmNameLabelText" Text="Naziv ritma:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CustomRhythmNameTextBox" Width="140" Text="Moj ritam" />
                    <Button x:Name="UseCustomRhythmButton" Content="Sačuvaj ritam" Margin="8,0,0,0" Click="UseCustomRhythmButton_Click" />
                    <Button x:Name="NewCustomRhythmButton" Content="Novi ritam" Margin="8,0,0,0" Click="NewCustomRhythmButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CustomRhythmStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,8,0,0" TextWrapping="Wrap" />

                <TextBlock x:Name="CustomRhythmSavedTitleText" FontWeight="Bold" Margin="0,16,0,0"
                           Text="Sačuvani sopstveni ritmovi:" />
                <ListBox x:Name="SavedCustomRhythmsListBox" Height="80" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="EditSavedCustomRhythmButton" Content="Uredi izabrani" Click="EditSavedCustomRhythmButton_Click" />
                    <Button x:Name="RemoveSavedCustomRhythmButton" Content="Ukloni izabrani ritam" Margin="8,0,0,0" Click="RemoveSavedCustomRhythmButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CustomRhythmSavedStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock x:Name="CustomRhythmTipText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Savet: napravi prvi takt, dodaj mu bubnjeve i note, pa „Dodaj kao novi takt”. Ako hoćeš varijaciju, napravi još jedan takt na isti način - svi taktovi će se odsvirati redom, u petlji." />
            </StackPanel>

            <!-- ==================== Zvuk i efekti (Ultra Composer 2.0): Ultra FM, izvođenje, arpeđator, efekti ==================== -->
            <!-- Texts are set in MainWindow.Sound.cs (ApplySoundViewLanguage); the ones here are only the Serbian defaults. -->
            <StackPanel Grid.Row="2" x:Name="SoundView" Visibility="Collapsed">
                <TextBlock x:Name="SoundTitleText" Text="Zvuk i efekti (Ultra Composer 2.0)" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock x:Name="SoundIntroText" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Label x:Name="SoundSectionsLabel" Content="_Odeljci:" Padding="0" Target="{Binding ElementName=SoundSectionsListBox}" />
                <ListBox x:Name="SoundSectionsListBox" Height="180" Margin="0,4,0,8"
                         SelectionChanged="SoundSectionsListBox_SelectionChanged"
                         PreviewKeyDown="SoundSectionsListBox_PreviewKeyDown" />
                <Label x:Name="SoundParamsLabel" Content="_Podešavanja:" Padding="0" Target="{Binding ElementName=SoundParamsListBox}" />
                <ListBox x:Name="SoundParamsListBox" Height="220" Margin="0,4,0,8"
                         PreviewKeyDown="SoundParamsListBox_PreviewKeyDown"
                         GotKeyboardFocus="SoundParamsListBox_GotKeyboardFocus" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SoundResetSectionButton" Content="_Vrati odeljak na početne vrednosti" Click="SoundResetSectionButton_Click" />
                    <Button x:Name="SoundPanicButton" Content="_Zaustavi sve tonove (panic)" Margin="8,0,0,0" Click="SoundPanicButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SoundStatusText" AutomationProperties.LiveSetting="Assertive" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SoundKeysHelpText" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

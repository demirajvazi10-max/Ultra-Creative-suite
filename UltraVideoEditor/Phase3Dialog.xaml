<Window x:Class="UltraVideoEditor.Phase3Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Highlight Suite — Phase 3"
        Width="780" Height="720"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainWindowBg}"
        AutomationProperties.Name="Phase 3 dialog: Transitions, Audio Mix, Accessibility and Export">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"      Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#9D5FFF"/>
        <SolidColorBrush x:Key="SuccessBrush"     Color="#10B981"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource PanelBg2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource PanelBg2}"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ThemeBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🎬  AI Highlight Suite — Phase 3"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Transitions · Smart Audio Mix · Accessibility · Multi-format Export"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Scroll content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- A: Audio Miks -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔊  A — Smart Audio Miks"
                                   Style="{StaticResource SectionHeader}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Music volume (%)"
                                           Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SliderMusicVol"
                                        Minimum="0" Maximum="100" Value="85"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Foreground="{StaticResource AccentBrush}"
                                        AutomationProperties.Name="Music volume"/>
                                <TextBlock x:Name="TxtMusicVol" Text="85%"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,2,0,8"/>

                                <TextBlock Text="Original audio volume (%)"
                                           Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SliderClipVol"
                                        Minimum="0" Maximum="100" Value="70"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Foreground="{StaticResource AccentBrush}"
                                        AutomationProperties.Name="Original audio volume"/>
                                <TextBlock x:Name="TxtClipVol" Text="70%"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="ChkDucking"
                                          Content="Ducking (music lowers during dialogue)"
                                          IsChecked="True"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontSize="12" Margin="0,0,0,8"
                                          AutomationProperties.Name="Enable audio ducking"/>
                                <CheckBox x:Name="ChkNormalize"
                                          Content="Normalize to -14 LUFS (YouTube)"
                                          IsChecked="True"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontSize="12" Margin="0,0,0,8"
                                          AutomationProperties.Name="Normalize volume"/>
                                <CheckBox x:Name="ChkMuteOriginal"
                                          Content="Mute original audio (music only)"
                                          IsChecked="False"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontSize="12"
                                          AutomationProperties.Name="Mute original clip audio"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- B: Tranzicije -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="✂️  B — Transition Engine"
                                   Style="{StaticResource SectionHeader}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <CheckBox x:Name="ChkEnableTransitions"
                                  Content="Automatically add transitions between segments (beat-synced)"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12" Margin="0,0,0,8"
                                  AutomationProperties.Name="Enable automatic transitions"/>
                        <TextBlock Text="Transition type is selected based on content: action→flash, portrait→dissolve, arc→wipe…"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- C: Accessibility -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="♿  C — Accessibility Report"
                                   Style="{StaticResource SectionHeader}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <CheckBox x:Name="ChkGenReport"
                                  Content="Generate audio-description report (TXT)"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12" Margin="0,0,0,8"
                                  AutomationProperties.Name="Generate accessibility report"/>
                        <CheckBox x:Name="ChkTtsSummary"
                                  Content="Include TTS-optimized summary"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12" Margin="0,0,0,4"
                                  AutomationProperties.Name="Include TTS summary"/>
                        <CheckBox x:Name="ChkNavMarkers"
                                  Content="Include navigation markers (timestamp list)"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12"
                                  AutomationProperties.Name="Include navigation markers"/>
                    </StackPanel>
                </Border>

                <!-- D: Export formati -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="💾  D — Export Pipeline"
                                   Style="{StaticResource SectionHeader}"
                                   AutomationProperties.HeadingLevel="Level2"/>

                        <TextBlock Text="Output folder:"
                                   Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="BtnPickFolder"
                                    DockPanel.Dock="Right"
                                    Content="…"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,7" Margin="6,0,0,0"
                                    Click="BtnPickFolder_Click"
                                    AutomationProperties.Name="Select output folder"/>
                            <TextBox x:Name="TxtOutputFolder"
                                     Background="{DynamicResource PanelBg}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource ThemeBorderBrush}"
                                     BorderThickness="1" Padding="8,6"
                                     FontSize="12"
                                     AutomationProperties.Name="Output folder path"/>
                        </DockPanel>

                        <TextBlock Text="Export formats:"
                                   Style="{StaticResource FieldLabel}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox x:Name="ChkExportYoutube"
                                      Content="🎬 YouTube FHD (1920×1080)"
                                      IsChecked="True"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="12" Margin="0,0,16,6"
                                      AutomationProperties.Name="Export for YouTube FHD"/>
                            <CheckBox x:Name="ChkExportReels"
                                      Content="📱 Reels / TikTok (1080×1920)"
                                      IsChecked="True"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="12" Margin="0,0,16,6"
                                      AutomationProperties.Name="Export for Instagram Reels and TikTok"/>
                            <CheckBox x:Name="ChkExportMp3"
                                      Content="🎵 MP3 Audio"
                                      IsChecked="True"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="12" Margin="0,0,16,6"
                                      AutomationProperties.Name="Export audio MP3"/>
                            <CheckBox x:Name="ChkExportReport"
                                      Content="♿ Accessibility TXT"
                                      IsChecked="True"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="12" Margin="0,0,0,6"
                                      AutomationProperties.Name="Export accessibility report"/>
                        </WrapPanel>

                        <CheckBox x:Name="ChkUseGPU"
                                  Content="⚡ GPU encoding (NVENC)"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="12" Margin="0,8,0,0"
                                  AutomationProperties.Name="Koristi GPU NVENC encoding"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Progress -->
        <Border Grid.Row="2"
                x:Name="ProgressPanel"
                Visibility="Collapsed"
                Background="{DynamicResource PanelBg}"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="TxtProgressPct"
                               Text="0%" DockPanel.Dock="Right"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtProgressMsg"
                               Text="Starting…"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="13"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressBar"
                             Height="6" Minimum="0" Maximum="100"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{DynamicResource ThemeBorderBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnClose" IsCancel="True"
                    DockPanel.Dock="Right"
                    Content="Close"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,9"
                    Click="BtnClose_Click"
                    AutomationProperties.Name="Close dialog"/>
            <Button x:Name="BtnRun"
                    DockPanel.Dock="Left"
                    Content="🚀 Start Phase 3"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,9"
                    Click="BtnRun_Click"
                    AutomationProperties.Name="Start all Phase 3 operations"
                    AutomationProperties.HelpText="Applies transitions, audio mix, generates accessibility report and exports to all selected formats"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="UltraAudioEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltraAudioEditor.ViewModels"
        xmlns:ctrl="clr-namespace:UltraAudioEditor.Controls"
        xmlns:vc="clr-namespace:UltraAudioEditor.Views.Controls"
        xmlns:models="clr-namespace:UltraAudioEditor.Models"
        Title="{DynamicResource L_app_title}"
        Height="820" Width="1280" MinHeight="600" MinWidth="900"
        Background="{StaticResource BrBgDark}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
        <KeyBinding Key="S" Command="{Binding StopCommand}"/>
        <KeyBinding Key="L" Command="{Binding LoopCommand}"/>
        <KeyBinding Key="Home" Command="{Binding ToStartCommand}"/>
        <KeyBinding Key="End" Command="{Binding ToEndCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl"       Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveProjectAsCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl"       Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="I" Modifiers="Ctrl"       Command="{Binding ImportAudioCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Alt" Command="{Binding AddTrackCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomFitCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveTrackUpCommand}"/>
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveTrackDownCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateTrackCommand}"/>
        <KeyBinding Key="W" Modifiers="Alt" Command="{Binding ToggleWorkspaceModeCommand}"/>
        <KeyBinding Key="F6" Command="{Binding AnnounceStatusCommand}"/>
        <!-- Clip pozicioniranje -->
        <KeyBinding Key="Left"  Modifiers="Ctrl"       Command="{Binding MoveClipLeftCommand}"/>
        <KeyBinding Key="Right" Modifiers="Ctrl"       Command="{Binding MoveClipRightCommand}"/>
        <KeyBinding Key="Left"  Modifiers="Ctrl+Shift" Command="{Binding MoveClipLeftFineCommand}"/>
        <KeyBinding Key="Right" Modifiers="Ctrl+Shift" Command="{Binding MoveClipRightFineCommand}"/>
        <KeyBinding Key="F2"                           Command="{Binding SetClipPositionCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Shift"     Command="{Binding DeleteClipCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Transport -->
            <RowDefinition Height="*"/>     <!-- Main Area -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════ MENU BAR ═══════════ -->
        <Menu Grid.Row="0" Background="{StaticResource BrBgPanel}" Foreground="{StaticResource BrText}"
              AutomationProperties.Name="{DynamicResource L_acc_main_menu}">
            <MenuItem Header="{DynamicResource L_menu_file}" AutomationProperties.Name="{DynamicResource L_acc_file_menu}">
                <MenuItem Header="{DynamicResource L_menu_new_project}" Command="{Binding NewProjectCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_new_project}"/>
                <MenuItem Header="{DynamicResource L_menu_open_project}" Command="{Binding OpenProjectCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_open_project}"/>
                <MenuItem Header="{DynamicResource L_menu_save}" Command="{Binding SaveProjectCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_save}"/>
                <MenuItem Header="{DynamicResource L_menu_save_as}" Command="{Binding SaveProjectAsCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_save_as}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_import_audio}" Command="{Binding ImportAudioCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_import_file}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_export_audio}" Command="{Binding ExportCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_export_audio}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_exit}" Click="MenuItem_Exit"
                          AutomationProperties.Name="{DynamicResource L_acc_exit}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_edit}" AutomationProperties.Name="{DynamicResource L_acc_menu_edit}">
                <MenuItem Header="{DynamicResource L_menu_undo}" Command="{Binding UndoCommand}" AutomationProperties.Name="{DynamicResource L_acc_undo}"/>
                <MenuItem Header="{DynamicResource L_menu_redo}" Command="{Binding RedoCommand}" AutomationProperties.Name="{DynamicResource L_acc_redo}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_normalize}" Command="{Binding NormalizeCommand}" AutomationProperties.Name="{DynamicResource L_acc_normalize_track}"/>
                <MenuItem Header="{DynamicResource L_menu_fade_in}" Command="{Binding FadeInCommand}" AutomationProperties.Name="{DynamicResource L_acc_fade_in}"/>
                <MenuItem Header="{DynamicResource L_menu_fade_out}" Command="{Binding FadeOutCommand}" AutomationProperties.Name="{DynamicResource L_acc_fade_out}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_clip}" AutomationProperties.Name="{DynamicResource L_acc_menu_clips}">
                <MenuItem Header="{DynamicResource L_menu_set_position}" Command="{Binding SetClipPositionCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_set_clip_pos}"/>
                <MenuItem Header="{DynamicResource L_menu_move_left_1s}" Command="{Binding MoveClipLeftCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_clip_left_1s}"/>
                <MenuItem Header="{DynamicResource L_menu_move_right_1s}" Command="{Binding MoveClipRightCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_clip_right_1s}"/>
                <MenuItem Header="{DynamicResource L_menu_move_left_01s}" Command="{Binding MoveClipLeftFineCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_fine_left}"/>
                <MenuItem Header="{DynamicResource L_menu_move_right_01s}" Command="{Binding MoveClipRightFineCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_fine_right}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_delete_clip}" Command="{Binding DeleteClipCommand}"
                          AutomationProperties.Name="{DynamicResource L_acc_delete_clip}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_tracks}" AutomationProperties.Name="{DynamicResource L_acc_menu_tracks}">
                <MenuItem Header="{DynamicResource L_menu_add_track}" Command="{Binding AddTrackCommand}" AutomationProperties.Name="{DynamicResource L_acc_add_track}"/>
                <MenuItem Header="{DynamicResource L_menu_delete_track}" Command="{Binding RemoveTrackCommand}" AutomationProperties.Name="{DynamicResource L_acc_delete_track}"/>
                <MenuItem Header="{DynamicResource L_menu_duplicate_track}" Command="{Binding DuplicateTrackCommand}" AutomationProperties.Name="{DynamicResource L_acc_duplicate_track}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_move_up}" Command="{Binding MoveTrackUpCommand}" AutomationProperties.Name="{DynamicResource L_acc_track_up}"/>
                <MenuItem Header="{DynamicResource L_menu_move_down}" Command="{Binding MoveTrackDownCommand}" AutomationProperties.Name="{DynamicResource L_acc_track_down}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource L_menu_mute_all}" Command="{Binding MuteAllCommand}" AutomationProperties.Name="{DynamicResource L_acc_mute_all}"/>
                <MenuItem Header="{DynamicResource L_menu_unmute_all}" Command="{Binding UnmuteAllCommand}" AutomationProperties.Name="{DynamicResource L_acc_unmute_all}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_ai}" AutomationProperties.Name="{DynamicResource L_acc_menu_ai}">
                <MenuItem Header="{DynamicResource L_menu_ai_transcription}" Command="{Binding AiTranscribeCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_transcribe_full}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_noise}" Command="{Binding AiNoiseRemoveCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_noise_full}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_smartcut}" Command="{Binding AiSmartCutCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_silence}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_vocal_sep}" Command="{Binding AiVocalSepCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_vocalsep}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_describe}" Command="{Binding AiDescribeCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_describe_full}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_vocal_mixer}" Command="{Binding AiVocalMixCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_vocalmix}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_eq}" Command="{Binding AiEqRecommendCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_eq_track}"/>
                <MenuItem Header="{DynamicResource L_menu_ai_autolevel}" Command="{Binding AiAutoLevelCommand}" AutomationProperties.Name="{DynamicResource L_acc_ai_levels}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_view}" AutomationProperties.Name="{DynamicResource L_acc_menu_view}">
                <MenuItem Header="{DynamicResource L_menu_zoom_in}" Command="{Binding ZoomInCommand}" AutomationProperties.Name="{DynamicResource L_acc_zoom_in}"/>
                <MenuItem Header="{DynamicResource L_menu_zoom_out}" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="{DynamicResource L_acc_zoom_out}"/>
                <MenuItem Header="{DynamicResource L_menu_zoom_fit}" Command="{Binding ZoomFitCommand}" AutomationProperties.Name="{DynamicResource L_acc_zoom_fit}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_language}" AutomationProperties.Name="{DynamicResource L_acc_lang_menu}">
                <MenuItem x:Name="MenuLangEn" Header="{DynamicResource L_menu_lang_en}" IsCheckable="True" Click="LangEn_Click" AutomationProperties.Name="English"/>
                <MenuItem x:Name="MenuLangSr" Header="{DynamicResource L_menu_lang_sr}" IsCheckable="True" Click="LangSr_Click" AutomationProperties.Name="Srpski"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_menu_help}" AutomationProperties.Name="{DynamicResource L_acc_menu_help}">
                <MenuItem Header="{DynamicResource L_menu_shortcuts}" Click="ShowShortcuts_Click" AutomationProperties.Name="{DynamicResource L_acc_show_shortcuts}"/>
                <MenuItem Header="{DynamicResource L_menu_about}" Click="ShowAbout_Click" AutomationProperties.Name="{DynamicResource L_acc_about}"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════ TOOLBAR ═══════════ -->
        <ToolBar Grid.Row="1" Background="{StaticResource BrBgPanel}" Band="0"
                 AutomationProperties.Name="{DynamicResource L_acc_toolbar}">
            <Button Command="{Binding NewProjectCommand}" ToolTip="{DynamicResource L_tt_new_project}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_new_project}">Novi</Button>
            <Button Command="{Binding ImportAudioCommand}" ToolTip="{DynamicResource L_tt_import}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_import}">Uvezi</Button>
            <Button Command="{Binding ExportCommand}" ToolTip="{DynamicResource L_tt_export}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_export_audio}">Izvezi</Button>
            <Separator/>
            <Button Command="{Binding UndoCommand}" ToolTip="{DynamicResource L_tt_undo}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_undo}">↩ Undo</Button>
            <Button Command="{Binding RedoCommand}" ToolTip="{DynamicResource L_tt_redo}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_redo}">↪ Redo</Button>
            <Separator/>
            <Button Command="{Binding NormalizeCommand}" ToolTip="{DynamicResource L_tt_normalize}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_normalize_track}">Normalizuj</Button>
            <Button Command="{Binding FadeInCommand}" ToolTip="{DynamicResource L_tt_fade_in}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_fade_in}">Fade In</Button>
            <Button Command="{Binding FadeOutCommand}" ToolTip="{DynamicResource L_tt_fade_out}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_fade_out}">Fade Out</Button>
            <Separator/>
            <Button Command="{Binding ZoomOutCommand}" ToolTip="{DynamicResource L_tt_zoom_out}"
                    Style="{StaticResource StdButton}" Width="28" AutomationProperties.Name="{DynamicResource L_acc_zoom_out}">−</Button>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrTextSec}" FontSize="11" Margin="4,0"
                       AutomationProperties.Name="{DynamicResource L_acc_zoom_level}">
                <TextBlock.Text>
                    <Binding Path="ZoomLevel" StringFormat="{}{0:F0}x" Mode="OneWay"/>
                </TextBlock.Text>
            </TextBlock>
            <Button Command="{Binding ZoomInCommand}" ToolTip="{DynamicResource L_tt_zoom_in}"
                    Style="{StaticResource StdButton}" Width="28" AutomationProperties.Name="{DynamicResource L_acc_zoom_in}">+</Button>
            <Button Command="{Binding ZoomFitCommand}" ToolTip="{DynamicResource L_tt_zoom_fit}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_zoom_fit_all}">Fit</Button>
            <Separator/>
            <Button Command="{Binding AddTrackCommand}" ToolTip="{DynamicResource L_tt_new_track}"
                    Style="{StaticResource StdButton}" AutomationProperties.Name="{DynamicResource L_acc_add_track}">+ Traka</Button>
        </ToolBar>

        <!-- ═══════════ TRANSPORT BAR ═══════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrBgPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1"
                AutomationProperties.Name="{DynamicResource L_acc_transport}">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Prikaz vremena -->
                <TextBlock Grid.Column="0"
                           Text="{Binding TimeDisplay, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource BrText}"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           AutomationProperties.Name="{DynamicResource L_acc_current_pos}"
                           AutomationProperties.LiveSetting="Polite"/>

                <!-- Transport dugmad -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource L_acc_transport_buttons}">
                    <Button Command="{Binding ToStartCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{DynamicResource L_tt_to_start}" AutomationProperties.Name="{DynamicResource L_acc_to_start}" Margin="0,0,4,0">⏮</Button>
                    <Button Command="{Binding PlayPauseCommand}" Style="{StaticResource TransportButton}" Margin="0,0,4,0"
                            ToolTip="{DynamicResource L_tt_play_pause}"
                            AutomationProperties.Name="{DynamicResource L_acc_play_pause}"
                            Width="44" Height="44" FontSize="18">
                        <TextBlock Text="{Binding PlayPauseLabel, Mode=OneWay}" FontSize="14"/>
                    </Button>
                    <Button Command="{Binding StopCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{DynamicResource L_tt_stop}" AutomationProperties.Name="{DynamicResource L_acc_stop}" Margin="0,0,4,0">■</Button>
                    <Button Command="{Binding RecordCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{DynamicResource L_tt_record}" AutomationProperties.Name="{DynamicResource L_acc_start_record}"
                            Foreground="{StaticResource BrDanger}" Margin="0,0,4,0">●</Button>
                    <Button Command="{Binding ToEndCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{DynamicResource L_tt_to_end}" AutomationProperties.Name="{DynamicResource L_acc_to_end}" Margin="0,0,4,0">⏭</Button>
                    <Button Command="{Binding LoopCommand}" Style="{StaticResource TransportButton}"
                            ToolTip="{DynamicResource L_tt_loop}" AutomationProperties.Name="{DynamicResource L_acc_loop}">⟳</Button>
                </StackPanel>

                <!-- Master Volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Label Content="{DynamicResource L_master_label}" Foreground="{StaticResource BrTextSec}" FontSize="11"
                           AutomationProperties.Name="{DynamicResource L_acc_master_volume}"/>
                    <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding MasterVolume}"
                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource L_acc_master_slider}"
                            AutomationProperties.HelpText="{DynamicResource L_master_help}"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0" FontSize="11"
                               Foreground="{StaticResource BrTextSec}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Text>
                            <Binding Path="MasterVolume" StringFormat="{}{0:P0}" Mode="OneWay"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN AREA ═══════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- Tracks + Timeline -->
                <ColumnDefinition Width="5" />  <!-- Splitter -->
                <ColumnDefinition Width="280"/> <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: Dual-Mode Workspace ─── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mode Bar -->
                <Border Grid.Row="0" Background="{StaticResource BrBgPanel}"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnVisualMode"
                                    Content="{DynamicResource L_visual_mode_btn}"
                                    Style="{StaticResource StdButton}"
                                    Click="BtnVisualMode_Click"
                                    Margin="4,2,0,2"
                                    AutomationProperties.Name="{DynamicResource L_acc_switch_visual}"
                                    ToolTip="{DynamicResource L_visual_mode_tt}"/>
                            <Button x:Name="BtnJawsMode"
                                    Content="{DynamicResource L_jaws_mode_btn}"
                                    Style="{StaticResource AIButton}"
                                    Click="BtnJawsMode_Click"
                                    Margin="4,2,0,2"
                                    AutomationProperties.Name="{DynamicResource L_acc_switch_jaws}"
                                    ToolTip="{DynamicResource L_jaws_mode_tt}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   x:Name="CurrentModeLabel"
                                   Text="{DynamicResource L_visual_mode_indicator}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrTextMuted}"
                                   Margin="0,0,8,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>

                <!-- ══ VIZUALNI MOD ══ -->
                <Grid Grid.Row="1" x:Name="VisualWorkspace">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="24" Background="{StaticResource BrBgPanel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,1,1">
                            <TextBlock Text="{DynamicResource L_tracks_header}" FontSize="10" Foreground="{StaticResource BrTextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Canvas Grid.Column="1" x:Name="RulerCanvas" Background="{StaticResource BrBgPanel}" ClipToBounds="True"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{DynamicResource L_acc_track_list_visual}">
                        <ItemsControl ItemsSource="{Binding Project.Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AudioTrack}">
                                    <Grid Height="{Binding Height}" MinHeight="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BrBgPanel}"
                                                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,1,1">
                                            <Border BorderBrush="{Binding ColorBrush, Mode=OneWay}" BorderThickness="3,0,0,0">
                                                <StackPanel Margin="6,4">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrText}"
                                                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <ToggleButton Content="M" Width="24" Height="20" FontSize="10" Margin="0,0,3,0"
                                                                      IsChecked="{Binding IsMuted}"
                                                                      AutomationProperties.Name="{DynamicResource L_acc_mute_btn}"
                                                                      Background="{Binding IsMuted, Converter={StaticResource BoolToMuteBrush}}"/>
                                                        <ToggleButton Content="S" Width="24" Height="20" FontSize="10" Margin="0,0,3,0"
                                                                      IsChecked="{Binding IsSolo}"
                                                                      AutomationProperties.Name="{DynamicResource L_acc_solo_btn}"
                                                                      Background="{Binding IsSolo, Converter={StaticResource BoolToSoloBrush}}"/>
                                                        <TextBlock Text="{Binding Type}" FontSize="9"
                                                                   Foreground="{StaticResource BrTextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{DynamicResource L_vol_short}" FontSize="10" Foreground="{StaticResource BrTextMuted}"
                                                                   Width="24" VerticalAlignment="Center"/>
                                                        <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding Volume}"
                                                                AutomationProperties.Name="{DynamicResource L_acc_track_volume}"/>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource BrTextSec}" Margin="3,0" VerticalAlignment="Center">
                                                            <TextBlock.Text><Binding Path="Volume" StringFormat="{}{0:P0}" Mode="OneWay"/></TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BrBorder}"
                                                BorderThickness="0,0,0,1" Background="#0F0F1A">
                                            <ctrl:WaveformControl
                                                Clips="{Binding Clips}"
                                                TrackColor="{Binding Color}"
                                                PlayheadPosition="{Binding DataContext.PlayheadPosition, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                ProjectDuration="{Binding DataContext.Project.Duration, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                ZoomLevel="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                AllowDrop="True" Drop="WaveformArea_Drop"
                                                MouseLeftButtonDown="WaveformArea_MouseDown">
                                                <ctrl:WaveformControl.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource L_ctx_set_clip_pos}"
                                                                  Command="{Binding DataContext.SetClipPositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem Header="{DynamicResource L_menu_move_left_1s}"
                                                                  Command="{Binding DataContext.MoveClipLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem Header="{DynamicResource L_menu_move_right_1s}"
                                                                  Command="{Binding DataContext.MoveClipRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem Header="{DynamicResource L_ctx_delete_clip}"
                                                                  Command="{Binding DataContext.DeleteClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </ContextMenu>
                                                </ctrl:WaveformControl.ContextMenu>
                                            </ctrl:WaveformControl>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ══ JAWS MOD ══ -->
                <vc:AccessibleTrackList Grid.Row="1" x:Name="AccessibleTrackList"
                    Visibility="Collapsed"
                    AutomationProperties.Name="{DynamicResource L_acc_jaws_view}"/>

            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BrBorder}"
                          AutomationProperties.Name="{DynamicResource L_acc_splitter}"/>

            <!-- ─── RIGHT PANEL ─── -->
            <Grid Grid.Column="2" Background="{StaticResource BrBgPanel}">
                <TabControl Background="{StaticResource BrBgPanel}"
                            Foreground="{StaticResource BrText}"
                            AutomationProperties.Name="{DynamicResource L_acc_right_panel}">
                    <TabItem Header="{DynamicResource L_effects_header}" AutomationProperties.Name="{DynamicResource L_acc_tab_effects}">
                        <TextBlock Text="{DynamicResource L_select_track_effects}" Margin="8"
                                   Foreground="{StaticResource BrTextSec}" FontSize="12"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource L_ai_panel_header}" AutomationProperties.Name="{DynamicResource L_acc_tab_ai}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="{DynamicResource L_ai_provider_label}" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrTextSec}" Margin="0,4,0,4"/>
                                <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                    <RadioButton Content="{DynamicResource L_ollama_local}" IsChecked="{Binding UseOllama}"
                                                 Foreground="#4ECFA0" FontWeight="Medium" Margin="0,0,0,4"
                                                 AutomationProperties.Name="{DynamicResource L_acc_use_ollama}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="{DynamicResource L_groq_free}" IsChecked="{Binding UseGroq}"
                                                     Foreground="{StaticResource BrText}" Margin="0,0,12,0"
                                                     AutomationProperties.Name="{DynamicResource L_acc_use_groq}"/>
                                        <RadioButton Content="{DynamicResource L_anthropic_claude}" IsChecked="{Binding UseAnthropic}"
                                                     Foreground="{StaticResource BrText}"
                                                     AutomationProperties.Name="{DynamicResource L_acc_use_anthropic}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding ApiKeyHint, Mode=OneWay}" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource BrTextSec}" Margin="0,4,0,4"/>
                                <PasswordBox x:Name="ApiKeyBox" Height="30"
                                             Background="{StaticResource BrBgMid}"
                                             Foreground="{StaticResource BrText}"
                                             BorderBrush="{StaticResource BrBorder}"
                                             BorderThickness="1"
                                             IsEnabled="{Binding NeedsApiKey}"
                                             Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVisibility}}"
                                             PasswordChanged="ApiKeyBox_PasswordChanged"
                                             AutomationProperties.Name="{DynamicResource L_acc_enter_api_key}"/>
                                <Button Click="OpenApiKeyLink_Click"
                                        Style="{StaticResource StdButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0" Height="22" Padding="4,2"
                                        AutomationProperties.Name="{DynamicResource L_acc_open_api_page}">
                                    <TextBlock Text="{Binding ApiKeyLink, Mode=OneWay}" FontSize="10" Foreground="#4ECFA0"/>
                                </Button>
                                <TextBlock FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,2,0,8"
                                           Text="{DynamicResource L_groq_quota}"/>
                                <Separator Margin="0,4,0,8" Background="{StaticResource BrBorder}"/>
                                <Label Content="{DynamicResource L_transcription_lang}" AutomationProperties.Name="{DynamicResource L_acc_lang_select}"/>
                                <ComboBox SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{DynamicResource L_acc_transcription_lang}">
                                    <ComboBoxItem>Srpski</ComboBoxItem>
                                    <ComboBoxItem>Engleski</ComboBoxItem>
                                    <ComboBoxItem>Njemacki</ComboBoxItem>
                                    <ComboBoxItem>Francuski</ComboBoxItem>
                                    <ComboBoxItem>Auto-detect</ComboBoxItem>
                                </ComboBox>
                                <Label Content="{DynamicResource L_noise_level}" Margin="0,6,0,0"/>
                                <ComboBox SelectedItem="{Binding SelectedNoiseLevel}" AutomationProperties.Name="{DynamicResource L_acc_noise_level}">
                                    <ComboBoxItem>Blag</ComboBoxItem>
                                    <ComboBoxItem>Srednji</ComboBoxItem>
                                    <ComboBoxItem>Agresivan</ComboBoxItem>
                                </ComboBox>
                                <Label Content="{DynamicResource L_silence_threshold}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="160" Minimum="-60" Maximum="-20" Value="{Binding SilenceThreshold}"
                                            AutomationProperties.Name="{DynamicResource L_acc_silence_slider}"/>
                                    <TextBlock Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource BrText}">
                                        <TextBlock.Text><Binding Path="SilenceThreshold" StringFormat="{}{0:F0} dB" Mode="OneWay"/></TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Separator Margin="0,8" Background="{StaticResource BrBorder}"/>
                                <Button Command="{Binding AiTranscribeCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_transcribe}">Transkripcija govora</Button>
                                <Button Command="{Binding AiNoiseRemoveCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_noise}">Ukloni sum (Denoise)</Button>
                                <Button Command="{Binding AiSmartCutCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_smartcut}">SmartCut (detekcija tisine)</Button>
                                <Button Command="{Binding AiVocalSepCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_vocalsep_short}">Vocal Separator (savjeti)</Button>
                                <Button Command="{Binding AiVocalMixCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_vocalmix_short}">Glas na Instrumental (mix)</Button>
                                <Button Command="{Binding AiEqRecommendCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_eq}">EQ Preporuke (odabrana traka)</Button>
                                <Button Command="{Binding AiAutoLevelCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_autolevel}">Auto Level (LUFS analiza)</Button>
                                <Button Command="{Binding AiDescribeCommand}" Style="{StaticResource AIButton}" Margin="0,0,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource L_acc_ai_describe}">Opis projekta (pristupacnost)</Button>
                                <Separator Margin="0,8" Background="{StaticResource BrBorder}"/>
                                <TextBlock Text="{DynamicResource L_ai_progress}" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,2"/>
                                <ProgressBar Height="8" Value="{Binding AiProgress, Mode=OneWay}" Maximum="100"
                                             Background="{StaticResource BrBgMid}" Foreground="{StaticResource BrAccentAI}"
                                             AutomationProperties.Name="{DynamicResource L_acc_ai_progress}"/>
                                <TextBlock Text="{DynamicResource L_ai_results}" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,8,0,2"/>
                                <TextBox Text="{Binding AiResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="150" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                         FontSize="11" FontFamily="Consolas"
                                         AutomationProperties.Name="{DynamicResource L_acc_ai_results}"
                                         AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource L_export_header}" AutomationProperties.Name="{DynamicResource L_acc_tab_export}">
                        <StackPanel Margin="8">
                            <TextBlock Text="{DynamicResource L_export_format}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrTextSec}" Margin="0,4,0,4"/>
                            <ComboBox SelectedItem="{Binding ExportFormat}" AutomationProperties.Name="{DynamicResource L_acc_export_format}">
                                <ComboBoxItem>WAV</ComboBoxItem>
                                <ComboBoxItem>MP3</ComboBoxItem>
                                <ComboBoxItem>OGG</ComboBoxItem>
                                <ComboBoxItem>FLAC</ComboBoxItem>
                                <ComboBoxItem>M4A</ComboBoxItem>
                                <ComboBoxItem>AIFF</ComboBoxItem>
                            </ComboBox>
                            <Button Command="{Binding ExportCommand}" Style="{StaticResource AIButton}"
                                    Margin="0,16,0,0" HorizontalAlignment="Stretch" Height="36"
                                    AutomationProperties.Name="{DynamicResource L_acc_start_export}">Izvezi audio</Button>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <StatusBar Grid.Row="4" Background="{StaticResource BrBgPanel}"
                   AutomationProperties.Name="{DynamicResource L_acc_status_bar}">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusMessage" Text="{Binding StatusMessage, Mode=OneWay}"
                           Foreground="{StaticResource BrText}" FontSize="11"
                           AutomationProperties.Name="{Binding StatusMessage, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="{StaticResource BrTextSec}" FontSize="11">
                    <TextBlock.Text><Binding Path="Project.Tracks.Count" StringFormat="{}{0} traka" Mode="OneWay"/></TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="{StaticResource BrTextSec}" FontSize="11">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} Hz / {1}-bit" Mode="OneWay">
                            <Binding Path="Project.SampleRate"/>
                            <Binding Path="Project.BitDepth"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{DynamicResource L_statusbar_ready}"
                           Foreground="{StaticResource BrTextMuted}" FontSize="10"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
<Window x:Class="UltraVideoEditor.PositionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set on audio timeline" Height="580" Width="520"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E"
        AutomationProperties.Name="Setting image on audio timeline">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Set image on audio timeline" FontSize="17" FontWeight="Bold"
                   Foreground="#00E676" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="txtAudioInfo" Foreground="#88CCFF" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="txtImageName" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtImageDesc" Foreground="#AAFFAA" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- MANUAL POSITIONING -->
        <Border Grid.Row="3" Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Manual positioning:" Foreground="#00E676" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Start (second):" Foreground="White" Margin="0,5,0,3"/>
                <TextBox x:Name="txtStart" Width="100" Height="30" Background="#2D2D2D"
                         Foreground="White" FontSize="14" Padding="5"
                         AutomationProperties.Name="Start position in seconds"/>

                <TextBlock Text="End (second):" Foreground="White" Margin="0,10,0,3"/>
                <TextBox x:Name="txtEnd" Width="100" Height="30" Background="#2D2D2D"
                         Foreground="White" FontSize="14" Padding="5"
                         AutomationProperties.Name="End position in seconds"/>

                <TextBlock Text="Duration (seconds):" Foreground="White" Margin="0,10,0,3"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtDuration" Width="80" Height="30" Background="#2D2D2D"
                             Foreground="White" FontSize="14" Padding="5"
                             AutomationProperties.Name="Image duration in seconds"/>
                    <TextBlock Text=" sec" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- AUTOMATSKI RASPORED -->
        <Border Grid.Row="4" Background="#1A2A1A" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Automatic layout:" Foreground="#00E676" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtAutoInfo" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button x:Name="btnAutoPlace" Content="Evenly distribute ALL images along audio axis"
                        Click="AutoPlace_Click" Height="34" Background="#1B5E20" Foreground="White"
                        FontWeight="Bold"
                        AutomationProperties.Name="Evenly distribute all images along the entire audio file"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="lstSchedule" Grid.Row="5" Background="#111111" Foreground="White"
                 FontSize="11" Margin="0,0,0,8" Height="120"
                 AutomationProperties.Name="Current image layout"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnApply" Content="APPLY" Click="Apply_Click"
                    Width="110" Height="34" Background="#2E7D32" Foreground="White"
                    FontSize="13" FontWeight="Bold" Margin="0,0,10,0"
                    AutomationProperties.Name="Apply position"/>
            <Button x:Name="btnCancel" Content="CANCEL" Click="Cancel_Click"
                    Width="110" Height="34" Background="#B71C1C" Foreground="White"
                    FontSize="13" FontWeight="Bold"
                    AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
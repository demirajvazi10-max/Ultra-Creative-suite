<Window x:Class="UltraAudioEditor.Views.SetClipPositionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_setpos_title}"
        Width="420" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrBgDark}"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Grid.Row="0"
                   x:Name="TitleBlock"
                   FontSize="14" FontWeight="Medium"
                   Foreground="{StaticResource BrText}"
                   Margin="0,0,0,16"
                   AutomationProperties.HeadingLevel="Level1"/>

        <!-- Uputstvo -->
        <TextBlock Grid.Row="1"
                   Text="{DynamicResource L_setpos_intro}"
                   Foreground="{StaticResource BrTextSec}" FontSize="12"
                   Margin="0,0,0,8"
                   AutomationProperties.Name="{DynamicResource L_acc_pos_help}"/>

        <!-- Input u sekundama -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SecondsBox"
                     Grid.Column="0"
                     FontSize="18" Height="40"
                     TextAlignment="Right"
                     AutomationProperties.Name="{DynamicResource L_acc_pos_seconds}"
                     AutomationProperties.HelpText="{DynamicResource L_setpos_sec_help}"
                     KeyDown="SecondsBox_KeyDown"/>
            <TextBlock Grid.Column="1" Text=" s"
                       VerticalAlignment="Center"
                       FontSize="16" Foreground="{StaticResource BrTextSec}"
                       Margin="6,0,0,0"/>
        </Grid>

        <!-- Format MM:SS alternativa -->
        <TextBlock Grid.Row="3"
                   Text="{DynamicResource L_setpos_mmss_intro}"
                   Foreground="{StaticResource BrTextSec}" FontSize="12"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="4" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TimeBox"
                     Grid.Column="0"
                     FontSize="16" Height="38"
                     AutomationProperties.Name="{DynamicResource L_acc_pos_mmss}"
                     AutomationProperties.HelpText="{DynamicResource L_setpos_mmss_help}"
                     KeyDown="TimeBox_KeyDown"/>
            <TextBlock Grid.Column="1" Text=" MM:SS"
                       VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource BrTextSec}"
                       Margin="6,0,0,0"/>
        </Grid>

        <!-- Dugmad -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Margin="0,0,8,0" Content="{DynamicResource L_btn_cancel}"
                    Style="{StaticResource StdButton}"
                    Width="90" Height="32"
                    Click="BtnCancel_Click"
                    AutomationProperties.Name="{DynamicResource L_acc_cancel_pos}"/>
            <Button x:Name="BtnOk" Content="{DynamicResource L_btn_set}"
                    Style="{StaticResource AIButton}"
                    Width="90" Height="32"
                    IsDefault="True"
                    Click="BtnOk_Click"
                    AutomationProperties.Name="{DynamicResource L_acc_confirm_pos}"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UltraVideoEditor.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" Background="#1A1A2E"
        AutomationProperties.Name="Window with all keyboard shortcuts"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="22" FontWeight="Bold"
                   Foreground="#00E676" HorizontalAlignment="Center" Margin="0,0,0,5"
                   AutomationProperties.Name="Precice na tastaturi"/>
        <TextBlock Grid.Row="1" Text="Press Escape or Alt+F4 to close"
                   Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,15"
                   FontSize="11"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Shortcut list" Focusable="True">
            <StackPanel>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="FILES AND PROJECT" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+N         New project" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+O         Open project" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+S         Save project" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F12            Save as..." Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+E         Export video (render)" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Alt+F4         Exit" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="EDITING" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Z         Undo" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Y         Redo" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+C         Copy clip" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+V         Paste clip" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+X         Cut clip at position" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Delete         Delete selected clip" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+A         Select all" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+D         Change clip duration" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Alt+V     Set volume" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Left      Move clip left" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Right     Move clip right" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Up        Move clip up (track)" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Down      Move clip down (track)" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ADDING MEDIA" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+I         Add video or image" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+I   Add audio file" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PLAYBACK" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Space     Play / Pause" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Left/Right     Seek +/- 5 seconds" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Home           Go to start" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="End            Go to end" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TIMELINE NAVIGATION" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Arrow up       Previous clip" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Arrow down     Next clip" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Page Up        5 clips up" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Page Down      5 clips down" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+L         Fokus na timeline listu" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl++         Zoom uvecaj" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+-         Zoom smanji" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+0         Resetuj zoom" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="MARKERI" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+M         Add marker" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+N   Sledeci marker" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+P   Prethodni marker" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+X   Seci na svim markerima" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ANIMACIJE I EFEKTI" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+K         Add keyframe" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+K   Ukloni keyframe" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+E   Primeni efekte" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PRISTUPACNOST (JAWS)" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Shift+A   Ukljuci/iskljuci pristupacni mod" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+L   Open log window" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F1             Open this shortcut list" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Desni klik     Kontekstni meni na klipu" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Enter/Space    Primeni tranziciju iz liste" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F1 (tranzicija) Procitaj opis efekta (JAWS)" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TABOVI" FontSize="14" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Tab       Sledeci tab" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+Tab Prethodni tab" Foreground="White" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="ZATVORI (Escape)" Click="CloseButton_Click"
                Height="36" Background="#2E7D32" Foreground="White"
                FontSize="13" FontWeight="Bold" Margin="0,15,0,0"
                AutomationProperties.Name="Close shortcuts window"/>
    </Grid>
</Window>
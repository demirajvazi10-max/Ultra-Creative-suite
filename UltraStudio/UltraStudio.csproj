<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UltraStudio</AssemblyName>
    <RootNamespace>UltraStudio</RootNamespace>
    <Product>Ultra Studio</Product>
    <Version>2.0.1</Version>
    <Company>Demir Ajvazi</Company>
    <Authors>Demir Ajvazi</Authors>
    <Copyright>Â© 2026 Demir Ajvazi</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Isti razlog kao u UltraAudioEditor.csproj: UseWindowsForms + UseWPF
         zajedno navode SDK da doda globalne "using System.Windows.Forms;" i
         "using System.Drawing;" u SVAKI fajl, Å¡to se sudara sa WPF-ovim
         Color/Application/UserControl/itd. NauÄeno sinoÄ‡ â€” ovde primenjeno
         od prvog dana, ne kao naknadna zakrpa. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Obrada slika â€” isti Magick.NET koji Video Editor veÄ‡ koristi, dokazano radi -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.15.0" />
    <!-- SAM (Segment Anything) â€” precizno izdvajanje objekata, isti ONNX Runtime
         koji Video Editor veÄ‡ koristi za MobileNet analizu kadrova -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.0" />
    <PackageReference Include="NPOI" Version="2.7.2" />
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202608250026-fd3a9" />
    <!-- HTTP za Ollama (opis slike preko Qwen2-VL) -->
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Folder/fajl dijalozi bez WinForms konflikta -->
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>
</Project>

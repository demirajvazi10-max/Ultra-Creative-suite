<Application x:Class="UltraVideoEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dark is the default theme. MainWindow.ApplyTheme() swaps this
                     dictionary at runtime for Contrast/Light — since it's merged at
                     the Application level, every open window (including dialogs)
                     picks up the change immediately via DynamicResource. -->
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
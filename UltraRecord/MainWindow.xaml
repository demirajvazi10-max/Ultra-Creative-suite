<Window x:Class="UltraRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="clr-namespace:UltraAccessibleKit.Theming;assembly=UltraAccessibleKit"
        Title="Ultra Record"
        Height="600" Width="820"
        Background="{DynamicResource MainWindowBg}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Tracks -->
            <RowDefinition Height="Auto"/>   <!-- Global controls -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddTrackButton"
                    Content="Add Track"
                    AutomationProperties.Name="Add new track"
                    Click="AddTrackButton_Click"
                    Margin="0,0,6,0" Padding="8,4"/>
            <Button x:Name="RemoveTrackButton"
                    Content="Remove Track"
                    AutomationProperties.Name="Remove selected track"
                    Click="RemoveTrackButton_Click"
                    Margin="0,0,6,0" Padding="8,4"/>
            <Button x:Name="ChooseFolderButton"
                    Content="Choose Output Folder..."
                    AutomationProperties.Name="Choose output folder"
                    Click="ChooseFolderButton_Click"
                    Margin="0,0,20,0" Padding="8,4"/>
            <theming:ThemeSwitcher/>
            <Button x:Name="AboutButton"
                    Content="About"
                    AutomationProperties.Name="About Ultra Record"
                    Click="AboutButton_Click"
                    Margin="20,0,0,0" Padding="8,4"/>
        </StackPanel>

        <!-- Tracks -->
        <ListBox x:Name="TracksListBox"
                 Grid.Row="1"
                 AutomationProperties.Name="Tracks"
                 SelectionChanged="TracksListBox_SelectionChanged"
                 Background="{DynamicResource PanelBg}"
                 BorderBrush="{DynamicResource ThemeBorderBrush}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Track name"
                                     Width="120" Margin="0,0,10,0"
                                     Background="{DynamicResource ControlBg}"
                                     Foreground="{DynamicResource TextPrimary}"/>
                            <ComboBox x:Name="DeviceComboBox"
                                      ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Index"
                                      SelectedValue="{Binding DeviceIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Input device"
                                      Width="220" Margin="0,0,10,0"/>
                            <CheckBox Content="Armed"
                                      IsChecked="{Binding IsArmed}"
                                      AutomationProperties.Name="Armed for recording"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       AutomationProperties.Name="Track status"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" MinWidth="140"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Global controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
            <Button x:Name="StartButton"
                    Content="Start Recording"
                    AutomationProperties.Name="Start recording all armed tracks"
                    Click="StartButton_Click"
                    Margin="0,0,10,0" Padding="10,6"/>
            <Button x:Name="StopButton"
                    Content="Stop Recording"
                    AutomationProperties.Name="Stop recording"
                    Click="StopButton_Click"
                    Padding="10,6"/>
            <TextBlock x:Name="OutputFolderText"
                       Text="No output folder chosen"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Ready."
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>

<Window x:Class="UltraVideoEditor.BatchExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Export — Multiple Projects"
        Width="820" Height="660"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MainWindowBg}"
        AutomationProperties.Name="Batch Export dialog">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"      Color="#F59E0B"/>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="#1A1A2E"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource PanelBg2}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📦  Batch Export"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="Add multiple .iskra projects and render them all with one click"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Settings -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBg2}"
                CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Format -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Format" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbFormat"
                              Background="{DynamicResource PanelBg}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource ThemeBorderBrush}"
                              FontSize="13" Padding="8,6"
                              AutomationProperties.Name="Select format for batch export">
                        <ComboBoxItem Content="YouTube FHD (MP4)" Tag="youtube" IsSelected="True"/>
                        <ComboBoxItem Content="TikTok / Reels (9:16)" Tag="reels"/>
                        <ComboBoxItem Content="MP3 Audio" Tag="mp3"/>
                    </ComboBox>
                </StackPanel>

                <!-- Output folder -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Output folder" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,5"/>
                    <DockPanel>
                        <Button x:Name="BtnPickFolder" DockPanel.Dock="Right"
                                Content="📁" Style="{StaticResource SecBtn}"
                                Padding="10,6" Margin="6,0,0,0"
                                Click="BtnPickFolder_Click"
                                AutomationProperties.Name="Select output folder"/>
                        <TextBox x:Name="TxtOutputFolder"
                                 Background="{DynamicResource PanelBg}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource ThemeBorderBrush}"
                                 BorderThickness="1" Padding="8,6" FontSize="12"
                                 IsReadOnly="True" Text="Not selected…"
                                 AutomationProperties.Name="Output folder path"/>
                    </DockPanel>
                </StackPanel>

                <!-- Add projects -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAddProjects" Content="➕ Add projects"
                            Style="{StaticResource PrimaryBtn}"
                            Click="BtnAddProjects_Click"
                            AutomationProperties.Name="Add .iskra project files"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ukupni progress -->
        <Border Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed"
                Background="{DynamicResource PanelBg}"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="TxtTotalPct" Text="0%"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtProgressMsg"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <ProgressBar x:Name="TotalProgressBar" Height="6"
                             Minimum="0" Maximum="100"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{DynamicResource ThemeBorderBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Lista jobova -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBg}"
                CornerRadius="8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PanelBg2}"
                        CornerRadius="8,8,0,0" Padding="12,8">
                    <DockPanel>
                        <Button x:Name="BtnClearDone" DockPanel.Dock="Right"
                                Content="Remove completed" Style="{StaticResource SecBtn}"
                                FontSize="11" Padding="10,4"
                                Margin="0,0,0,0" Click="BtnClearDone_Click"
                                AutomationProperties.Name="Remove completed jobs from list"/>
                        <Button x:Name="BtnRemoveSelected" DockPanel.Dock="Right"
                                Content="Remove" Style="{StaticResource SecBtn}"
                                FontSize="11" Padding="10,4" Margin="0,0,8,0"
                                Click="BtnRemoveSelected_Click"
                                AutomationProperties.Name="Remove selected job"/>
                        <TextBlock x:Name="TxtJobCount" Text="No projects"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                </Border>
                <ListView x:Name="JobsList" Grid.Row="1"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          FontSize="12" SelectionMode="Single"
                          AutomationProperties.Name="Batch export jobs list">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Project"  Width="200"
                                            DisplayMemberBinding="{Binding ProjectName}"/>
                            <GridViewColumn Header="Format"    Width="130"
                                            DisplayMemberBinding="{Binding FormatId}"/>
                            <GridViewColumn Header="Status"    Width="110"
                                            DisplayMemberBinding="{Binding StatusLabel}"/>
                            <GridViewColumn Header="Progress"  Width="80"
                                            DisplayMemberBinding="{Binding ProgressPct, StringFormat={}{0:F0}%}"/>
                            <GridViewColumn Header="Output"    Width="200"
                                            DisplayMemberBinding="{Binding OutputFile}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBg}"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,10" Height="70">
            <TextBox x:Name="TxtLog"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextSecondary}"
                     FontFamily="Consolas" FontSize="11"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Batch export log messages"/>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button x:Name="BtnStartBatch" DockPanel.Dock="Left"
                    Content="▶ Start Batch Export"
                    Style="{StaticResource PrimaryBtn}"
                    Padding="16,9" IsEnabled="False"
                    Click="BtnStartBatch_Click"
                    AutomationProperties.Name="Start batch export of all projects"/>
            <Button x:Name="BtnClose" DockPanel.Dock="Right" IsCancel="True"
                    Content="Close" Style="{StaticResource SecBtn}"
                    Padding="16,9" Click="BtnClose_Click"
                    AutomationProperties.Name="Close dialog"/>
            <Button x:Name="BtnOpenFolder" DockPanel.Dock="Right"
                    Content="📁 Open folder" Style="{StaticResource SecBtn}"
                    Padding="16,9" Margin="0,0,8,0" IsEnabled="False"
                    Click="BtnOpenFolder_Click"
                    AutomationProperties.Name="Open output folder"/>
        </DockPanel>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="MainWindowBg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg2" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ControlBg" Color="#2D2D2D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
    <!-- Text used ON TOP of colored action buttons (Apply/Cancel/Warning/Purple) -->
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>

    <!-- Accents / actions -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00E676"/>
    <SolidColorBrush x:Key="ApplyBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="CancelBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#4A148C"/>

    <!-- Structure -->
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#333333"/>

</ResourceDictionary>

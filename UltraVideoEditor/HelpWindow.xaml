<Window x:Class="UltraVideoEditor.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MainWindowBg}"
        AutomationProperties.Name="Window with all keyboard shortcuts"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"
                   AutomationProperties.Name="Precice na tastaturi"/>
        <TextBlock Grid.Row="1" Text="Press Escape or Alt+F4 to close"
                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,15"
                   FontSize="11"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Shortcut list" Focusable="True">
            <StackPanel>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="FILES AND PROJECT" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+N         New project" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+O         Open project" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+S         Save project" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F12            Save as..." Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+E         Export video (render)" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Alt+F4         Exit" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="EDITING" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Z         Undo" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Y         Redo" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+C         Copy clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+V         Paste clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+X         Cut clip at position" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Delete         Delete selected clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+A         Select all" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+D         Change clip duration" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Alt+V     Set volume" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Left      Move clip left" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Right     Move clip right" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Up        Move clip up (track)" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Down      Move clip down (track)" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ADDING MEDIA" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+I         Add video or image" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+I   Add audio file" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PLAYBACK" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Space     Play / Pause" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Left/Right     Seek +/- 5 seconds" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Home           Go to start" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="End            Go to end" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TIMELINE NAVIGATION" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Arrow up       Previous clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Arrow down     Next clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Page Up        5 clips up" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Page Down      5 clips down" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+L         Focus timeline list" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl++         Zoom in" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+-         Zoom out" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+0         Reset zoom" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="MARKERS" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+M         Add marker" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+N   Next marker" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+P   Previous marker" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+X   Cut at all markers" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ANIMATIONS AND EFFECTS" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+K         Add keyframe" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+K   Remove keyframe" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+E   Apply effects" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ACCESSIBILITY (JAWS)" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Shift+A   Toggle accessibility mode" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+L   Open log window" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F1             Open this shortcut list" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Right click    Context menu on clip" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Enter/Space    Apply transition from list" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="F1 (transition) Read effect description (JAWS)" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="TABS" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ctrl+Tab       Next tab" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                        <TextBlock Text="Ctrl+Shift+Tab Previous tab" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" Margin="5,2"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" Content="CLOSE (Escape)" Click="CloseButton_Click"
                Height="36" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}"
                FontSize="13" FontWeight="Bold" Margin="0,15,0,0"
                AutomationProperties.Name="Close shortcuts window"/>
    </Grid>
</Window>
<Window x:Class="UltraVideoEditor.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 API Keys" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <TextBlock Text="🔑 API Keys" FontSize="16" FontWeight="Bold"
                   Foreground="#00E676" HorizontalAlignment="Center" Margin="0,0,0,15"
                   AutomationProperties.Name="API Keys dialog"/>

        <!-- Pixabay -->
        <TextBlock Grid.Row="1" Text="Pixabay API key:" Foreground="White" Margin="0,0,0,5"/>
        <TextBox x:Name="txtApiKey" Grid.Row="2" Height="30" Padding="5"
                 Background="#2D2D2D" Foreground="White" FontSize="12"
                 AutomationProperties.Name="Pixabay API key"
                 AutomationProperties.HelpText="Unesi Pixabay API key za preuzimanje video klipova"/>

        <!-- Razdjelnik -->
        <Separator Grid.Row="3" Margin="0,15,0,5" Background="#444"/>

        <!-- Azure AI Foundry -->
        <TextBlock Grid.Row="4"
                   Text="☁ Microsoft Azure AI Foundry (Accessibility IQ layer — opciono)"
                   Foreground="#64B5F6" FontWeight="Bold" Margin="0,5,0,8"
                   AutomationProperties.Name="Microsoft Azure AI Foundry sekcija — opciono"/>

        <TextBlock Grid.Row="5" Text="Project endpoint:" Foreground="#CCC" Margin="0,0,0,3" FontSize="11"/>
        <TextBox x:Name="txtAzureEndpoint" Grid.Row="6" Height="30" Padding="5"
                 Background="#2D2D2D" Foreground="White" FontSize="11"
                 AutomationProperties.Name="Azure AI Foundry project endpoint"
                 AutomationProperties.HelpText="Endpoint URL iz Azure AI Foundry projekta, npr. https://ime-resursa.services.ai.azure.com"/>

        <TextBlock Grid.Row="7" Text="API key:" Foreground="#CCC" Margin="0,8,0,3" FontSize="11"/>
        <TextBox x:Name="txtAzureApiKey" Grid.Row="8" Height="30" Padding="5"
                 Background="#2D2D2D" Foreground="White" FontSize="11"
                 AutomationProperties.Name="Azure AI Foundry API key"
                 AutomationProperties.HelpText="API key iz Azure AI Foundry projekta"/>

        <TextBlock Grid.Row="9" Text="Model deployment (default: gpt-4o-mini):" Foreground="#CCC" Margin="0,8,0,3" FontSize="11"/>
        <TextBox x:Name="txtAzureDeployment" Grid.Row="10" Height="30" Padding="5"
                 Background="#2D2D2D" Foreground="White" FontSize="11"
                 Text="gpt-4o-mini"
                 AutomationProperties.Name="Azure AI model deployment name"
                 AutomationProperties.HelpText="Naziv deployovanog modela, npr. gpt-4o-mini ili gpt-4o"/>

        <!-- Dugmad -->
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30"
                    Click="BtnCancel_Click" Background="#B71C1C" Foreground="White"
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Cancel — zatvori bez snimanja"/>
            <Button x:Name="btnSave" Content="Save" Width="80" Height="30"
                    Click="BtnSave_Click" Background="#2E7D32" Foreground="White"
                    AutomationProperties.Name="Save — snimi API ključeve"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>

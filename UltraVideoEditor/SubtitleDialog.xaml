<Window x:Class="UltraVideoEditor.SubtitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add subtitle to clip" Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ControlBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Subtitle text:" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,0,10"/>
        <TextBox x:Name="txtText" Grid.Row="1" Height="60" TextWrapping="Wrap" 
                 Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15" AutomationProperties.Name="Subtitle text"/>

        <TextBlock Grid.Row="2" Text="Show for entire clip" Foreground="{DynamicResource AccentBrush}" 
                   FontSize="12" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnOk" Content="✅ CONFIRM" Click="Ok_Click" Width="100" Height="35" IsDefault="True"
                    Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" Margin="0,0,10,0" AutomationProperties.Name="Confirm subtitle"/>
            <Button x:Name="btnCancel" Content="❌ CANCEL" Click="Cancel_Click" Width="100" Height="35" IsCancel="True"
                    Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}" AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
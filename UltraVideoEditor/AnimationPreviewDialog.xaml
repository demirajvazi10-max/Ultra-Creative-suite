<Window x:Class="UltraVideoEditor.AnimationPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation scenario preview" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ControlBg}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎬 AI PROPOSED SCENARIO" FontSize="16" FontWeight="Bold" 
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Text="You can change the image, duration and effect for each scene:" 
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

        <ListBox x:Name="lstScenes" Grid.Row="1" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}"
                 AutomationProperties.Name="Scene list - you can change parameters">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="5" Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Image:" Foreground="{DynamicResource TextPrimary}" Width="50" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding AvailableImages}" SelectedItem="{Binding ImageName}" 
                                          Width="150" Margin="0,0,10,0"
                                          AutomationProperties.Name="Image selection for scene"/>
                                <TextBlock Text="Duration (s):" Foreground="{DynamicResource TextPrimary}" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Duration}" Width="50" Margin="0,0,10,0"
                                         AutomationProperties.Name="Scene duration in seconds"/>
                                <TextBlock Text="Effect:" Foreground="{DynamicResource TextPrimary}" Width="50" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding AvailableEffects}" SelectedItem="{Binding Effect}" 
                                          Width="100" AutomationProperties.Name="Effect selection for scene"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="btnConfirm" Content="✅ CONFIRM AND CREATE ANIMATION" Click="Confirm_Click" IsDefault="True"
                    Width="220" Height="40" Background="{DynamicResource ApplyBrush}" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="❌ CANCEL" Click="Cancel_Click" IsCancel="True"
                    Width="100" Height="40" Background="{DynamicResource CancelBrush}" Foreground="{DynamicResource ButtonTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>